{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senvakara",
  "version": "0.1.0",
  "identifier": "dev.senvakara.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Senvakara",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/scrcpy-server-v3.3.3",
      "resources/THIRD_PARTY_NOTICES.md"
    ],
    "publisher": "Senvakara",
    "shortDescription": "Control Linux hosts and Android phones from one Windows app",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
