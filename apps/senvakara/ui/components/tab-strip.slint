// The session tab strip: a pinned Home tab, one tab per open session, a button for the New Tab
// page and, next to it, a menu of local shells and hosts to open at once.

import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { Icon, IconButton } from "controls.slint";
import { LaunchItem, LaunchIcon } from "new-tab.slint";

export struct TabInfo {
    id: int,
    // "terminal" | "mirror" | "logcat" | "files" | "desktop" | "workspace" | "run" | "new-tab"
    kind: string,
    title: string,
    detail: string,
    hue: int,
    exited: bool,
}

component TabButton inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <color> hue: Theme.accent;
    // A session on a machine shows the machine's hue as a small tile; Home does not.
    in property <bool> tinted: true;
    in property <bool> active;
    in property <bool> exited;
    in property <bool> closable: true;
    callback selected();
    callback closed();
    // The tab became the active one: the strip scrolls it into view.
    callback shown();

    changed active => {
        if (self.active) {
            root.shown();
        }
    }

    height: Theme.tab-height;
    min-width: 72px;
    border-radius: Theme.radius;
    background: active ? Theme.surface-hover : touch.has-hover ? Theme.text.with-alpha(0.07) : Theme.text.with-alpha(0.035);
    accessible-role: tab;
    accessible-label: exited ? title + ", ended" : title;
    accessible-item-selected: active;
    accessible-action-default => {
        root.selected();
    }
    animate background { duration: Theme.quick; }

    touch := TouchArea {
        clicked => {
            root.selected();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle && root.closable) {
                root.closed();
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-1 + 2px;
        padding-right: root.closable ? Theme.space-1 : Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Theme.radius-small + 1px;
                background: !root.tinted ? transparent : root.exited ? Theme.surface-selected : root.hue;
                Icon {
                    width: 14px;
                    height: 14px;
                    source: root.icon;
                    tint: !root.tinted ? (root.active ? Theme.text : Theme.text-muted) : root.exited ? Theme.text-faint : Theme.tile-ink;
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.title;
            color: root.exited ? Theme.text-faint : root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.text-body - 1px;
            font-weight: Theme.weight-medium;
            overflow: elide;
            max-width: 180px;
        }

        if root.exited: Text {
            vertical-alignment: center;
            text: "ended";
            color: Theme.text-faint;
            font-size: Theme.text-small;
        }

        if root.closable: VerticalLayout {
            alignment: center;
            IconButton {
                size: 22px;
                icon: @image-url("../icons/close.svg");
                label: "Close " + root.title;
                clicked => {
                    root.closed();
                }
            }
        }
    }
}

export component TabStrip inherits Rectangle {
    in property <[TabInfo]> tabs;
    // -1 is Home.
    in property <int> active: -1;
    callback select(int);
    callback close(int);
    callback new-session();
    // The SFTP pane's tab, pinned after Home rather than in line with the sessions; -1 if none.
    in property <int> sftp-tab: -1;
    callback open-sftp();
    // The menu next to "+": local shells, then hosts, then phones.
    in property <[LaunchItem]> quick;
    // The menu is about to open.
    callback quick-opening();
    callback quick-run(int);

    private property <length> menu-row: Theme.row;

    height: Theme.tab-strip;
    background: Theme.shell;

    HorizontalLayout {
        padding-left: Theme.space-2 + 2px;
        padding-right: Theme.space-2 + 2px;
        padding-top: (Theme.tab-strip - Theme.tab-height) / 2;
        padding-bottom: (Theme.tab-strip - Theme.tab-height) / 2;
        spacing: Theme.space-1 + 1px;
        alignment: start;

        TabButton {
            icon: @image-url("../icons/home.svg");
            title: "Home";
            tinted: false;
            closable: false;
            active: root.active < 0;
            selected => {
                root.select(-1);
            }
        }

        TabButton {
            icon: @image-url("../icons/folder.svg");
            title: "SFTP";
            tinted: false;
            closable: root.sftp-tab >= 0;
            active: root.sftp-tab >= 0 && root.active == root.sftp-tab;
            selected => {
                root.open-sftp();
            }
            closed => {
                root.close(root.sftp-tab);
            }
        }

        // Session tabs scroll sideways when they do not fit; "+" stays right after them.
        flick := Flickable {
            horizontal-stretch: 0;
            min-width: 0px;
            preferred-width: row.preferred-width;
            content-width: row.preferred-width;
            content-height: self.height;
            interactive: false;

            wheel := TouchArea {
                width: row.preferred-width;
                height: parent.height;
                scroll-event(event) => {
                    if (flick.content-width <= flick.width) {
                        return reject;
                    }
                    flick.content-x = Math.max(flick.width - flick.content-width, Math.min(0px, flick.content-x + event.delta-y + event.delta-x));
                    return accept;
                }

                row := HorizontalLayout {

                    // The SFTP pane is shown pinned after Home, so its own place stays empty.
                    for tab[index] in root.tabs: HorizontalLayout {
                        padding-left: index == 0 || index == root.sftp-tab ? 0px : Theme.space-1 + 1px;

                        if index != root.sftp-tab: TabButton {
                            icon: tab.kind == "mirror" ? @image-url("../icons/phone.svg") : tab.kind == "logcat" ? @image-url("../icons/list.svg") : tab.kind == "files" ? @image-url("../icons/folder.svg") : tab.kind == "desktop" ? @image-url("../icons/monitor.svg") : tab.kind == "workspace" ? @image-url("../icons/layout.svg") : tab.kind == "run" ? @image-url("../icons/play.svg") : tab.kind == "new-tab" ? @image-url("../icons/plus.svg") : @image-url("../icons/terminal.svg");
                            title: tab.title;
                            hue: Theme.host-hue(tab.hue);
                            // The New Tab page belongs to no machine yet.
                            tinted: tab.kind != "new-tab";
                            exited: tab.exited;
                            active: root.active == index;
                            selected => {
                                root.select(index);
                            }
                            closed => {
                                root.close(index);
                            }
                            shown => {
                                if (parent.x + self.x + flick.content-x < 0) {
                                    flick.content-x = -(parent.x + self.x);
                                } else if (parent.x + self.x + self.width + flick.content-x > flick.width) {
                                    flick.content-x = flick.width - parent.x - self.x - self.width;
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            padding-left: Theme.space-1;
            HorizontalLayout {
                spacing: 2px;

                IconButton {
                    size: Theme.tab-height;
                    icon: @image-url("../icons/plus.svg");
                    label: "New tab";
                    clicked => {
                        root.new-session();
                    }
                }

                chevron := IconButton {
                    size: Theme.tab-height;
                    icon: @image-url("../icons/chevron-down.svg");
                    label: "Open a shell or a host in a new tab";
                    clicked => {
                        root.quick-opening();
                        menu.show();
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        // Under the chevron, pulled left when the window is too narrow for it there.
        x: Math.max(Theme.space-2, Math.min(chevron.absolute-position.x - root.absolute-position.x, root.width - self.width - Theme.space-2));
        y: root.height - 2px;
        width: 340px;
        height: Math.min(12, Math.max(1, root.quick.length)) * root.menu-row + 2 * Theme.space-1;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.hairline-strong;
            background: Theme.surface;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 15px;
            drop-shadow-color: #00000040;

            ListView {
                x: Theme.space-1;
                y: Theme.space-1;
                width: parent.width - 2 * Theme.space-1;
                height: parent.height - 2 * Theme.space-1;
                accessible-label: "Shells and hosts to open";

                for item[index] in root.quick: Rectangle {
                    height: root.menu-row;
                    border-radius: Theme.radius - 3px;
                    border-width: row-focus.has-focus ? 1px : 0px;
                    border-color: Theme.accent;
                    background: row-touch.pressed ? Theme.surface-selected : row-touch.has-hover || row-focus.has-focus ? Theme.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: item.label == "" ? item.title + ", " + item.detail : item.title + ", " + item.detail + ", " + item.label;
                    accessible-action-default => {
                        menu.close();
                        root.quick-run(index);
                    }

                    row-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                menu.close();
                                root.quick-run(index);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.close();
                            root.quick-run(index);
                        }
                    }

                    if item.divider: Rectangle {
                        x: 0;
                        y: 0;
                        height: 1px;
                        background: Theme.hairline;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;

                        VerticalLayout {
                            alignment: center;
                            LaunchIcon {
                                kind: item.kind;
                                hue: item.hue;
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            vertical-alignment: center;
                            text: item.title;
                            color: Theme.text;
                            font-size: Theme.text-body;
                            overflow: elide;
                        }

                        Text {
                            vertical-alignment: center;
                            text: item.label;
                            color: Theme.text-faint;
                            font-size: Theme.text-small;
                        }
                    }
                }
            }

            if root.quick.length == 0: Text {
                text: "Looking for shells on this PC.";
                color: Theme.text-muted;
                font-size: Theme.text-small;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
        z: -1;
    }
}
