// The session tab strip: a pinned Home tab, one tab per open session, and a new-session button.

import { Theme } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";

export struct TabInfo {
    id: int,
    // "terminal" | "mirror" | "logcat" | "files" | "desktop" | "workspace" | "run"
    kind: string,
    title: string,
    detail: string,
    hue: int,
    exited: bool,
}

component TabButton inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <color> hue: Theme.accent;
    in property <bool> active;
    in property <bool> exited;
    in property <bool> closable: true;
    callback selected();
    callback closed();

    height: Theme.tab-strip - 6px;
    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;
    background: active ? Theme.ground : touch.has-hover ? Theme.surface : transparent;
    accessible-role: tab;
    accessible-label: exited ? title + ", ended" : title;
    accessible-item-selected: active;
    accessible-action-default => {
        root.selected();
    }
    animate background { duration: Theme.quick; }

    touch := TouchArea {
        clicked => {
            root.selected();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle && root.closable) {
                root.closed();
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: root.closable ? Theme.space-1 : Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.exited ? Theme.text-faint : root.active ? root.hue : Theme.text-muted;
            }
        }

        Text {
            vertical-alignment: center;
            text: root.title;
            color: root.exited ? Theme.text-faint : root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.text-body;
            font-weight: root.active ? 600 : 400;
            overflow: elide;
            max-width: 180px;
        }

        if root.exited: Text {
            vertical-alignment: center;
            text: "ended";
            color: Theme.text-faint;
            font-size: Theme.text-small;
        }

        if root.closable: VerticalLayout {
            alignment: center;
            IconButton {
                size: 22px;
                icon: @image-url("../icons/close.svg");
                label: "Close " + root.title;
                clicked => {
                    root.closed();
                }
            }
        }
    }

    // The machine this session runs on, as a colour under the active tab.
    if root.active: Rectangle {
        x: Theme.space-2;
        y: parent.height - 2px;
        width: parent.width - 2 * Theme.space-2;
        height: 2px;
        border-radius: 1px;
        background: root.hue;
    }
}

export component TabStrip inherits Rectangle {
    in property <[TabInfo]> tabs;
    // -1 is Home.
    in property <int> active: -1;
    callback select(int);
    callback close(int);
    callback new-session();

    height: Theme.tab-strip;
    background: Theme.shell;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: 6px;
        spacing: 2px;
        alignment: start;

        TabButton {
            icon: @image-url("../icons/home.svg");
            title: "Home";
            closable: false;
            active: root.active < 0;
            selected => {
                root.select(-1);
            }
        }

        for tab[index] in root.tabs: TabButton {
            icon: tab.kind == "mirror" ? @image-url("../icons/phone.svg") : tab.kind == "logcat" ? @image-url("../icons/list.svg") : tab.kind == "files" ? @image-url("../icons/folder.svg") : tab.kind == "desktop" ? @image-url("../icons/monitor.svg") : tab.kind == "workspace" ? @image-url("../icons/layout.svg") : tab.kind == "run" ? @image-url("../icons/play.svg") : @image-url("../icons/terminal.svg");
            title: tab.title;
            hue: Theme.host-hue(tab.hue);
            exited: tab.exited;
            active: root.active == index;
            selected => {
                root.select(index);
            }
            closed => {
                root.close(index);
            }
        }

        VerticalLayout {
            alignment: center;
            padding-left: Theme.space-1;
            IconButton {
                icon: @image-url("../icons/plus.svg");
                label: "New PowerShell session";
                clicked => {
                    root.new-session();
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
        z: -1;
    }
}
