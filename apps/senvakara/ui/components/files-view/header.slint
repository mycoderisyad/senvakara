// The top row of one side of the Files tab: the place it shows (a click changes it), the name
// filter and the Actions menu.

import { Theme } from "../../theme.slint";
import { Icon, IconButton } from "../controls.slint";
import { MenuRow } from "../widgets.slint";
import { Files, FileSide } from "data.slint";

// A quiet text button of the header ("Filter", "Actions").
component HeaderAction inherits Rectangle {
    in property <image> lead-icon;
    in property <image> trail-icon;
    in property <string> text;
    in property <string> label: text;
    callback clicked();

    private property <color> ink: touch.has-hover ? Theme.text : Theme.text-muted;

    height: 28px;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-small;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-1 + 2px;

        if root.lead-icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                source: root.lead-icon;
                tint: root.ink;
            }
        }

        Text {
            vertical-alignment: center;
            text: root.text;
            color: root.ink;
            font-size: Theme.text-small + 1px;
            font-weight: Theme.weight-medium;
        }

        if root.trail-icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: 12px;
                height: 12px;
                source: root.trail-icon;
                tint: root.ink;
            }
        }
    }
}

// The place this side shows, as a tile in its colour and its name. A click lists the places.
component PlaceSwitch inherits Rectangle {
    in property <FileSide> info;
    in property <string> side-name;
    callback clicked();

    height: 30px;
    min-width: row.preferred-width;
    border-radius: Theme.radius-small;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: touch.pressed ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.info.place + ". Switch host, phone or this PC on the " + root.side-name + " side";
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Theme.radius-small;
                background: Theme.host-hue(root.info.hue);
                Icon {
                    width: 13px;
                    height: 13px;
                    source: root.info.place-kind == "local" ? @image-url("../../icons/windows.svg") : root.info.place-kind == "phone" ? @image-url("../../icons/phone.svg") : @image-url("../../icons/server.svg");
                    tint: Theme.tile-ink;
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.info.place;
            color: Theme.text;
            font-size: Theme.text-body;
            font-weight: Theme.weight-strong;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                width: 12px;
                height: 12px;
                source: @image-url("../../icons/chevron-down.svg");
                tint: touch.has-hover ? Theme.text-muted : Theme.text-faint;
            }
        }
    }
}

// "Filter", which opens into a small field. Escape or the cross clears the filter and closes it.
component FilterBox inherits HorizontalLayout {
    in property <string> side-name;
    // Rust dropped the filter (another folder, another place): show the closed button again.
    in property <string> reset-key;
    // The text to filter the names by; "" for no filter.
    callback edited(string);

    private property <bool> open;

    horizontal-stretch: 0;
    spacing: Theme.space-2;

    function dismiss() {
        input.text = "";
        root.open = false;
        root.edited("");
    }

    changed reset-key => {
        input.text = "";
        root.open = false;
    }

    if !root.open: VerticalLayout {
        alignment: center;
        HeaderAction {
            lead-icon: @image-url("../../icons/search.svg");
            text: "Filter";
            label: "Filter names on the " + root.side-name + " side";
            clicked => {
                root.open = true;
                input.focus();
            }
        }
    }

    // Always there, so that it can take the keyboard the moment it opens.
    VerticalLayout {
        visible: root.open;
        alignment: center;
        Rectangle {
            width: root.open ? 156px : 0px;
            height: 28px;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.hairline-strong;
            background: Theme.ground;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: 4px;
                spacing: Theme.space-1;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 13px;
                        height: 13px;
                        source: @image-url("../../icons/search.svg");
                        tint: Theme.text-faint;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    if input.text == "": Text {
                        x: 0;
                        width: parent.width;
                        vertical-alignment: center;
                        text: "Filter";
                        color: Theme.text-faint;
                        font-size: Theme.text-small + 1px;
                        overflow: elide;
                    }

                    input := TextInput {
                        x: 0;
                        width: parent.width;
                        vertical-alignment: center;
                        single-line: true;
                        enabled: root.open;
                        color: Theme.text;
                        font-size: Theme.text-small + 1px;
                        selection-background-color: Theme.accent.with-alpha(0.35);
                        selection-foreground-color: Theme.text;
                        accessible-label: "Filter the names on the " + root.side-name + " side";
                        edited => {
                            root.edited(self.text);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.dismiss();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        size: 20px;
                        icon: @image-url("../../icons/close.svg");
                        label: "Clear and close filter, " + root.side-name + " side";
                        clicked => {
                            root.dismiss();
                        }
                    }
                }
            }
        }
    }
}

component MenuDivider inherits Rectangle {
    height: 1px;
    background: Theme.hairline-strong;
}

// "Actions" and its menu: everything that can be done to the selection and to the folder. The
// right-click menu of the list (table.slint) offers the same actions.
component ActionsMenu inherits Rectangle {
    in property <int> pane;
    in property <int> side;
    in property <FileSide> info;
    in property <string> side-name;
    in property <bool> alone;
    in property <bool> has-rows;
    // These three open a strip under the header, which the pane owns.
    callback request-rename();
    callback request-new-folder();
    callback request-chmod();

    width: trigger.preferred-width;
    height: 28px;

    trigger := HeaderAction {
        text: "Actions";
        trail-icon: @image-url("../../icons/chevron-down.svg");
        label: "Actions for the " + root.side-name + " side";
        clicked => {
            menu.show();
        }
    }

    // Closes on any click, also on one of its own rows.
    menu := PopupWindow {
        x: parent.width - self.width;
        y: parent.height + Theme.space-1;
        width: 224px;

        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.hairline-strong;
            background: Theme.surface;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000059;

            VerticalLayout {
                padding: Theme.space-1;
                spacing: 2px;

                if !root.alone: MenuRow {
                    icon: @image-url("../../icons/import.svg");
                    title: "Copy to target directory";
                    enabled: root.info.copy-reason == "";
                    activated => {
                        Files.copy(root.pane, root.side);
                    }
                }

                MenuRow {
                    icon: @image-url("../../icons/edit.svg");
                    title: "Rename";
                    enabled: root.info.rename-reason == "";
                    activated => {
                        root.request-rename();
                    }
                }

                MenuRow {
                    icon: @image-url("../../icons/trash.svg");
                    title: "Delete";
                    danger: true;
                    enabled: root.info.delete-reason == "";
                    activated => {
                        Files.delete-selected(root.pane, root.side);
                    }
                }

                MenuDivider { }

                MenuRow {
                    icon: @image-url("../../icons/refresh.svg");
                    title: "Refresh";
                    activated => {
                        Files.refresh(root.pane, root.side);
                    }
                }

                MenuRow {
                    icon: @image-url("../../icons/folder.svg");
                    title: "New Folder";
                    enabled: root.info.new-folder-reason == "";
                    activated => {
                        root.request-new-folder();
                    }
                }

                MenuRow {
                    icon: root.info.show-hidden ? @image-url("../../icons/eye-off.svg") : @image-url("../../icons/eye.svg");
                    title: root.info.show-hidden ? "Hide Hidden Files" : "Show Hidden Files";
                    activated => {
                        Files.toggle-hidden(root.pane, root.side);
                    }
                }

                if root.info.place-kind == "host": MenuRow {
                    icon: @image-url("../../icons/lock.svg");
                    title: "Edit Permissions";
                    enabled: root.info.chmod-reason == "";
                    activated => {
                        root.request-chmod();
                    }
                }

                MenuRow {
                    icon: @image-url("../../icons/check.svg");
                    title: "Select All";
                    enabled: root.has-rows;
                    activated => {
                        Files.select-all(root.pane, root.side);
                    }
                }

                MenuDivider { }

                MenuRow {
                    icon: @image-url("../../icons/close.svg");
                    title: "Close";
                    danger: true;
                    activated => {
                        Files.close-side(root.pane, root.side);
                    }
                }
            }
        }
    }
}

export component PaneHeader inherits HorizontalLayout {
    in property <int> pane;
    in property <int> side;
    in property <FileSide> info;
    in property <string> side-name;
    // Only this side is on screen: nothing can be copied across.
    in property <bool> alone;
    in property <bool> has-rows;
    callback request-rename();
    callback request-new-folder();
    callback request-chmod();

    height: 40px;
    padding-left: Theme.space-3;
    padding-right: Theme.space-3;
    spacing: Theme.space-2;

    VerticalLayout {
        alignment: center;
        PlaceSwitch {
            info: root.info;
            side-name: root.side-name;
            clicked => {
                Files.pick-show(root.pane, root.side, true);
            }
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    FilterBox {
        side-name: root.side-name;
        reset-key: root.pane + "/" + root.info.filter-rev;
        edited(text) => {
            Files.filter(root.pane, root.side, text);
        }
    }

    VerticalLayout {
        alignment: center;
        ActionsMenu {
            pane: root.pane;
            side: root.side;
            info: root.info;
            side-name: root.side-name;
            alone: root.alone;
            has-rows: root.has-rows;
            request-rename => {
                root.request-rename();
            }
            request-new-folder => {
                root.request-new-folder();
            }
            request-chmod => {
                root.request-chmod();
            }
        }
    }
}
