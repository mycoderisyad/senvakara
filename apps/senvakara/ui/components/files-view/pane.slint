// One side of the Files tab, top to bottom: the header (header.slint), the path row
// (path-row.slint), the strip that is open if any (strips.slint), what went wrong, and the list
// (table.slint). A side that shows no place yet invites to choose one (picker.slint).

import { Theme } from "../../theme.slint";
import { Notice } from "../widgets.slint";
import { Files, FileRow, FileSide, FileCrumb, FilePlace } from "data.slint";
import { PaneHeader } from "header.slint";
import { PathRow } from "path-row.slint";
import { EmptySide, PlacePicker } from "picker.slint";
import { ChmodStrip, NameStrip } from "strips.slint";
import { FileTable } from "table.slint";

export component FilePane inherits Rectangle {
    in property <int> pane;
    in property <int> side;
    in property <FileSide> info;
    in property <[FileRow]> rows;
    in property <[FileCrumb]> crumbs;
    in property <[FilePlace]> places;
    // Only this side is on screen (a narrow workspace panel): nothing can be copied across.
    in property <bool> alone;
    // How wide this side is, more or less: columns give way to the name when it is narrow.
    in property <length> room;

    private property <string> side-name: side == 0 ? "left" : "right";
    // The strip that is open under the header: "" | "new-folder" | "rename" | "chmod".
    private property <string> strip;
    // Another folder or another pane is on screen: what a strip asked about is gone.
    private property <string> shown: pane + "/" + info.input-rev + "/" + info.input;

    // The menus and the keys of the list ask for a strip; it opens only when Rust allows the
    // action behind it.
    function open-new-folder() {
        if (root.info.new-folder-reason == "") {
            root.strip = "new-folder";
        }
    }

    function open-rename() {
        if (root.info.rename-reason == "" && root.info.selected-name != "") {
            root.strip = "rename";
        }
    }

    function open-chmod() {
        if (root.info.chmod-reason == "" && root.info.selected-name != "") {
            root.strip = "chmod";
        }
    }

    changed shown => {
        root.strip = "";
    }

    hover := TouchArea {
        changed has-hover => {
            if (self.has-hover) {
                Files.hovered(root.pane, root.side);
            }
        }

        if root.info.picking: PlacePicker {
            pane: root.pane;
            side: root.side;
            places: root.places;
            can-leave: root.info.place-kind != "";
        }

        if !root.info.picking && root.info.place-kind == "": EmptySide {
            pane: root.pane;
            side: root.side;
        }

        VerticalLayout {
            visible: !root.info.picking && root.info.place-kind != "";

            Rectangle {
                background: Theme.surface.mix(Theme.ground, 0.45);
                height: chrome.preferred-height;

                chrome := VerticalLayout {
                    PaneHeader {
                        pane: root.pane;
                        side: root.side;
                        info: root.info;
                        side-name: root.side-name;
                        alone: root.alone;
                        has-rows: root.rows.length > 0;
                        request-rename => {
                            root.open-rename();
                        }
                        request-new-folder => {
                            root.open-new-folder();
                        }
                        request-chmod => {
                            root.open-chmod();
                        }
                    }

                    PathRow {
                        pane: root.pane;
                        side: root.side;
                        info: root.info;
                        crumbs: root.crumbs;
                        side-name: root.side-name;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.hairline;
                    }
                }
            }

            if root.strip == "new-folder": NameStrip {
                placeholder: "New folder name";
                field-label: "Name of the new folder on the " + root.side-name + " side";
                confirm-text: "Create";
                confirm-label: "Create the folder, " + root.side-name + " side";
                cancel-label: "Do not create a folder, " + root.side-name + " side";
                accepted(name) => {
                    root.strip = "";
                    Files.new-folder(root.pane, root.side, name);
                }
                cancelled => {
                    root.strip = "";
                }
            }

            if root.strip == "rename": NameStrip {
                value: root.info.selected-name;
                placeholder: "New name";
                field-label: "New name on the " + root.side-name + " side";
                confirm-text: "Rename";
                confirm-label: "Rename item, " + root.side-name + " side";
                cancel-label: "Cancel rename, " + root.side-name + " side";
                accepted(name) => {
                    root.strip = "";
                    Files.rename(root.pane, root.side, name);
                }
                cancelled => {
                    root.strip = "";
                }
            }

            if root.strip == "chmod": ChmodStrip {
                item-name: root.info.selected-name;
                side-name: root.side-name;
                // An item whose permissions are not known starts from rw-r--r-- (0o644).
                mode: root.info.selected-mode >= 0 ? root.info.selected-mode : 420;
                applied(mode) => {
                    root.strip = "";
                    Files.chmod(root.pane, root.side, mode);
                }
                cancelled => {
                    root.strip = "";
                }
            }

            if root.info.error != "": VerticalLayout {
                padding: Theme.space-2;
                Notice {
                    kind: "danger";
                    text: root.info.error;
                }
            }

            if root.info.note != "": VerticalLayout {
                padding: Theme.space-2;
                Notice {
                    kind: "info";
                    text: root.info.note;
                }
            }

            FileTable {
                vertical-stretch: 1;
                pane: root.pane;
                side: root.side;
                alone: root.alone;
                info: root.info;
                rows: root.rows;
                show-time: root.room >= 380px;
                show-kind: root.room >= 480px;
                request-rename => {
                    root.open-rename();
                }
                request-new-folder => {
                    root.open-new-folder();
                }
                request-chmod => {
                    root.open-chmod();
                }
            }
        }
    }
}
