// The host half of the inspector that takes input: the form to add or edit a host, and the
// addresses a host can be reached at. Checking and saving happen in Rust. The pieces are in
// host-form/: the view models, one file per card, and the network paths.

import { Theme } from "../theme.slint";
import { IconButton } from "controls.slint";
import { Button, Notice, Reason, Hint } from "widgets.slint";
import { HostForm, NetPaths, KeyChoice } from "host-form/model.slint";
import { AddressCard, GeneralCard } from "host-form/general.slint";
import { ConnectionCard } from "host-form/credentials.slint";
import { NetworkPaths } from "host-form/paths.slint";

export { HostForm, NetPaths, KeyChoice, NetworkPaths }

export component HostFormPanel inherits VerticalLayout {
    private property <int> revision: HostForm.revision;
    private property <string> wait: HostForm.saving ? "The host is being saved." : "";

    spacing: Theme.space-3;

    changed revision => {
        address.focus-input();
    }

    init => {
        address.focus-input();
    }

    HorizontalLayout {
        spacing: Theme.space-2;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: HostForm.title;
            color: Theme.text;
            font-size: Theme.text-title;
            font-weight: Theme.weight-strong;
            overflow: elide;
        }

        IconButton {
            icon: @image-url("../icons/close.svg");
            label: "Close the form";
            clicked => {
                HostForm.cancel();
            }
        }
    }

    address := AddressCard { }

    GeneralCard { }

    ConnectionCard { }

    if HostForm.editing && HostForm.protocol == "ssh": Hint {
        text: "Changing the address or port requires verifying the host key again.";
    }

    if HostForm.error != "": Notice {
        kind: "danger";
        text: HostForm.error;
    }

    HorizontalLayout {
        spacing: Theme.space-2;

        Button {
            horizontal-stretch: 1;
            text: HostForm.saving ? "Saving" : "Connect";
            kind: "primary";
            enabled: !HostForm.saving;
            reason: root.wait;
            accessible-label: HostForm.protocol == "rdp" ? "Save the host and open it in Remote Desktop" : "Save the host and open a terminal on it";
            clicked => {
                HostForm.connect();
            }
        }

        Button {
            text: "Save";
            enabled: !HostForm.saving;
            reason: root.wait;
            accessible-label: "Save host";
            clicked => {
                HostForm.save();
            }
        }

        Button {
            text: "Cancel";
            kind: "ghost";
            enabled: !HostForm.saving;
            reason: root.wait;
            accessible-label: "Cancel the host form";
            clicked => {
                HostForm.cancel();
            }
        }
    }

    Reason {
        text: root.wait;
    }
}
