// The third card of the host form: the port, who signs in and with what, and the startup snippet.

import { Theme } from "../../theme.slint";
import { Icon } from "../controls.slint";
import { Button, Card, CheckBox, Chip, Hint, IconField, LinkRow, MenuRow, TextArea, TextField } from "../widgets.slint";
import { HostForm } from "model.slint";
import { CardTitle } from "general.slint";

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline-strong;
}

// The password of the host: a field while there is none (or a new one is being typed), and
// only the fact that one is saved otherwise.
component PasswordPart inherits VerticalLayout {
    private property <bool> typing: HostForm.password-mode == "empty" || HostForm.password-mode == "replace";

    spacing: Theme.space-2;

    if root.typing: IconField {
        icon: @image-url("../../icons/lock.svg");
        secret: !HostForm.show-password;
        text <=> HostForm.password;
        label: "Password";
        placeholder: HostForm.password-mode == "replace" ? "New password" : "Password";
        trail-icon: HostForm.show-password ? @image-url("../../icons/eye.svg") : @image-url("../../icons/eye-off.svg");
        trail-label: HostForm.show-password ? "Hide the password" : "Show the password";
        edited => {
            HostForm.edited();
        }
        accepted => {
            HostForm.save();
        }
        trail-clicked => {
            HostForm.toggle-password();
        }
    }

    if HostForm.password-mode == "saved": HorizontalLayout {
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../../icons/lock.svg");
                tint: Theme.success;
            }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: "Password saved";
            color: Theme.text;
            font-size: Theme.text-body;
            overflow: elide;
        }

        Button {
            text: "Replace";
            accessible-label: "Replace the saved password";
            clicked => {
                HostForm.set-password-mode("replace");
            }
        }

        Button {
            text: "Remove";
            kind: "danger";
            accessible-label: "Remove the saved password";
            clicked => {
                HostForm.set-password-mode("remove");
            }
        }
    }

    if HostForm.password-mode == "replace" || HostForm.password-mode == "remove": HorizontalLayout {
        spacing: Theme.space-2;

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: HostForm.password-mode == "remove" ? "The saved password is removed when you save." : "Replaces the saved password when you save.";
            color: Theme.text-muted;
            font-size: Theme.text-small;
            wrap: word-wrap;
        }

        Button {
            text: "Keep saved";
            accessible-label: "Keep the saved password";
            clicked => {
                HostForm.set-password-mode("saved");
            }
        }
    }

    if HostForm.password-note != "": Hint {
        text: HostForm.password-note;
    }

    if HostForm.password-error != "": Hint {
        text: HostForm.password-error;
        ink: Theme.danger;
    }
}

// What an SSH host signs in with instead of a password: the chosen key as a chip, the fields a
// key file needs, and the menu that offers the choices.
component KeyPart inherits VerticalLayout {
    spacing: Theme.space-2;

    if HostForm.auth != "password": HorizontalLayout {
        alignment: start;
        spacing: Theme.space-2;

        Chip {
            icon: HostForm.auth == "agent" ? @image-url("../../icons/usb-key.svg") : @image-url("../../icons/key.svg");
            text: HostForm.auth == "keychain" ? HostForm.key-label : HostForm.auth == "agent" ? "Security key or agent" : "Key file";
            removable: true;
            remove-label: "Stop signing in with this key";
            removed => {
                HostForm.clear-key();
            }
        }

        if HostForm.auth == "keychain" && HostForm.key-certificate: Chip {
            icon: @image-url("../../icons/certificate.svg");
            text: "certificate";
        }
    }

    if HostForm.auth == "key_file": HorizontalLayout {
        spacing: Theme.space-2;

        TextField {
            horizontal-stretch: 1;
            mono: true;
            text <=> HostForm.key-path;
            label: "Private key file";
            placeholder: "Path to the key file";
            edited => {
                HostForm.edited();
            }
            accepted => {
                HostForm.save();
            }
        }

        Button {
            text: "Browse";
            accessible-label: "Browse for the private key file";
            clicked => {
                HostForm.browse();
            }
        }
    }

    if HostForm.key-error != "": Hint {
        text: HostForm.key-error;
        ink: Theme.danger;
    }

    if HostForm.auth == "key_file": IconField {
        icon: @image-url("../../icons/lock.svg");
        secret: true;
        text <=> HostForm.passphrase;
        label: "Key passphrase";
        placeholder: HostForm.has-passphrase ? "New passphrase (one is saved)" : "Key passphrase (optional)";
        edited => {
            HostForm.edited();
        }
        accepted => {
            HostForm.save();
        }
    }

    if HostForm.auth == "key_file" && HostForm.has-passphrase: HorizontalLayout {
        alignment: start;
        CheckBox {
            text: "Remove saved passphrase";
            checked: HostForm.remove-passphrase;
            toggled(on) => {
                HostForm.set-remove-passphrase(on);
            }
        }
    }

    if HostForm.auth == "agent": Hint {
        text: "The Windows OpenSSH agent signs in, with a FIDO2 security key or any key added to it. The agent service must be running.";
    }

    if HostForm.auth != "password": Hint {
        text: "The password is not used while a key signs in.";
    }

    Rectangle {
        height: add.height;

        add := LinkRow {
            width: parent.width;
            icon: @image-url("../../icons/plus.svg");
            text: "Key, Certificate, FIDO2";
            clicked => {
                menu.show();
            }
        }

        // Closes on any click, also on one of its own rows.
        menu := PopupWindow {
            x: 0;
            y: parent.height + Theme.space-1;
            width: parent.width;

            Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.hairline-strong;
                background: Theme.surface;
                drop-shadow-blur: 30px;
                drop-shadow-offset-y: 12px;
                drop-shadow-color: #00000059;

                VerticalLayout {
                    padding: Theme.space-1;
                    spacing: 2px;

                    if HostForm.keys.length == 0: Text {
                        height: Theme.row;
                        vertical-alignment: center;
                        text: "  The Keychain has no keys yet.";
                        color: Theme.text-faint;
                        font-size: Theme.text-small;
                    }

                    for key in HostForm.keys: MenuRow {
                        icon: key.fido ? @image-url("../../icons/usb-key.svg") : @image-url("../../icons/key.svg");
                        title: key.label;
                        detail: key.detail;
                        mark: key.certificate ? "certificate" : "";
                        activated => {
                            HostForm.pick-key(key.id);
                        }
                    }

                    Divider { }

                    MenuRow {
                        icon: @image-url("../../icons/file.svg");
                        title: "Key file...";
                        activated => {
                            HostForm.pick-key-file();
                        }
                    }

                    MenuRow {
                        icon: @image-url("../../icons/plus.svg");
                        title: "New key in Keychain...";
                        activated => {
                            HostForm.new-key();
                        }
                    }

                    MenuRow {
                        icon: @image-url("../../icons/usb-key.svg");
                        title: "Security key / agent (FIDO2)";
                        activated => {
                            HostForm.pick-agent();
                        }
                    }
                }
            }
        }
    }
}

export component ConnectionCard inherits Card {
    private property <bool> ssh: HostForm.protocol == "ssh";

    pad: Theme.space-3;
    gap: Theme.space-2;

    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-2;

        CardTitle {
            vertical-alignment: center;
            text: root.ssh ? "SSH on" : "Remote Desktop on";
        }

        TextField {
            width: 76px;
            mono: true;
            text <=> HostForm.port;
            label: "Port";
            placeholder: root.ssh ? "22" : "3389";
            edited => {
                HostForm.edited();
            }
            accepted => {
                HostForm.save();
            }
        }

        CardTitle {
            vertical-alignment: center;
            text: "port";
        }
    }

    if HostForm.port-error != "": Hint {
        text: HostForm.port-error;
        ink: Theme.danger;
    }

    Divider { }

    CardTitle {
        text: "Credentials";
    }

    IconField {
        icon: @image-url("../../icons/user.svg");
        mono: true;
        text <=> HostForm.username;
        label: "User name";
        placeholder: "Username";
        edited => {
            HostForm.edited();
        }
        accepted => {
            HostForm.save();
        }
    }

    if HostForm.username-error != "": Hint {
        text: HostForm.username-error;
        ink: Theme.danger;
    }

    if !root.ssh || HostForm.auth == "password": PasswordPart { }

    if root.ssh: KeyPart { }

    if root.ssh: Divider { }

    if root.ssh: TextArea {
        height: 72px;
        text <=> HostForm.snippet;
        label: "Startup snippet";
        placeholder: "Startup snippet";
        edited => {
            HostForm.edited();
        }
    }

    if root.ssh && HostForm.snippet-error != "": Hint {
        text: HostForm.snippet-error;
        ink: Theme.danger;
    }

    if root.ssh: Hint {
        text: "Typed into the shell once after signing in. It is stored as plain text with the host, not as a secret: do not put passwords or tokens in it.";
    }
}
