// Rows and list items: MeterRow, DetailRow, SidebarItem and ItemCard.

import { Theme } from "../../theme.slint";
import { Icon } from "../controls.slint";
import { Action, Meter, KeyValue } from "../../data.slint";
import { StatusMark } from "status.slint";

export component MeterRow inherits VerticalLayout {
    in property <Meter> meter;
    private property <color> ink: meter.fraction > 0.9 ? Theme.danger : meter.fraction > 0.75 ? Theme.warning : Theme.accent;

    spacing: 4px;

    HorizontalLayout {
        Text {
            text: root.meter.label;
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        Text {
            horizontal-alignment: right;
            text: root.meter.value;
            color: Theme.text;
            font-size: Theme.text-small;
        }
    }

    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.hairline;
        Rectangle {
            x: 0;
            width: parent.width * Math.clamp(root.meter.fraction, 0, 1);
            border-radius: 2px;
            background: root.ink;
            animate width { duration: 240ms; easing: ease-out; }
        }
    }
}

export component DetailRow inherits HorizontalLayout {
    in property <KeyValue> item;
    spacing: Theme.space-3;

    Text {
        width: 112px;
        text: root.item.key;
        color: Theme.text-muted;
        font-size: Theme.text-small;
        vertical-alignment: top;
    }

    Text {
        text: root.item.value;
        color: Theme.text;
        font-size: Theme.text-small;
        font-weight: Theme.weight-medium;
        font-family: root.item.mono ? Theme.mono : Theme.sans;
        wrap: root.item.mono ? char-wrap : word-wrap;
        horizontal-stretch: 1;
    }
}

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> badge;
    in property <bool> active;
    callback clicked();

    height: Theme.row;
    border-radius: Theme.radius;
    background: active ? Theme.surface-selected : touch.has-hover || focus.has-focus ? Theme.surface-hover : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: active;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3 - 2px;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                source: root.icon;
                tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-muted;
            }
        }

        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: root.text;
            color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
            font-size: Theme.text-body;
            font-weight: Theme.weight-medium;
        }

        if root.badge != "": Text {
            vertical-alignment: center;
            text: root.badge;
            color: Theme.text-faint;
            font-size: Theme.text-small;
        }
    }
}

// A two-line list card: icon tile, name, route or address, state in a fixed right-hand cell.
export component ItemCard inherits Rectangle {
    in property <image> icon;
    in property <color> hue: Theme.accent;
    in property <string> title;
    in property <string> subtitle;
    in property <string> tone;
    in property <string> state-text;
    in property <bool> selected;
    in property <[Action]> actions;
    callback select();
    callback open();
    callback action(string);

    height: 64px;
    border-radius: Theme.radius-card;
    border-width: selected || focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: title + ", " + subtitle + ", " + state-text;
    accessible-item-selected: selected;
    accessible-action-default => {
        root.open();
    }
    animate background { duration: Theme.quick; }

    ContextMenuArea {
        Menu {
            for entry in root.actions: MenuItem {
                title: entry.label;
                enabled: entry.reason == "";
                activated => {
                    root.action(entry.id);
                }
            }
        }

        focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return) {
                    root.open();
                    return accept;
                }
                if (event.text == " ") {
                    root.select();
                    return accept;
                }
                return reject;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.select();
            }
            double-clicked => {
                root.open();
            }
        }

        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-4;
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Theme.radius + 2px;
                    background: root.hue;
                    Icon {
                        width: 20px;
                        height: 20px;
                        source: root.icon;
                        tint: Theme.tile-ink;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                min-width: 0px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.text-body;
                    font-weight: Theme.weight-medium;
                    overflow: elide;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text-muted;
                    font-size: Theme.text-small;
                    overflow: elide;
                }
            }

            StatusMark {
                width: 100px;
                tone: root.tone;
                text: root.state-text;
            }
        }
    }
}
