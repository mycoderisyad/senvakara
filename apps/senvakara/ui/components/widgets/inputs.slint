// Text and choice inputs: SearchField, TextField, BoundField, CheckBox, Segmented and Select.

import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Icon } from "../controls.slint";

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    height: Theme.row;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : touch.has-hover ? Theme.hairline-strong : Theme.hairline;
    background: Theme.surface;
    animate border-color { duration: Theme.quick; }

    // Clicking anywhere on the field, the icon included, puts the caret in it.
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../../icons/search.svg");
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.text-body;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                single-line: true;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.text-body;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.placeholder;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }
}

// A one-line text field. `label` is its accessible name.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> mono;
    // Hide what is typed (a passphrase).
    in property <bool> secret;
    callback edited(string);
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    height: Theme.row;
    min-width: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline-strong;
    background: enabled ? Theme.field : Theme.surface;
    animate border-color { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.text-body;
                font-family: root.mono ? Theme.mono : Theme.sans;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                input-type: root.secret ? InputType.password : InputType.text;
                text <=> root.text;
                color: root.enabled ? Theme.text : Theme.text-faint;
                font-size: Theme.text-body;
                font-family: root.mono ? Theme.mono : Theme.sans;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.label == "" ? root.placeholder : root.label;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }
}

// A check box with its label. The mark is a shape, not only a colour.
export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Why the box cannot be changed; the caller shows it next to the box.
    in property <string> reason;
    callback toggled(bool);

    height: Theme.row;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    accessible-role: checkbox;
    accessible-label: enabled || reason == "" ? text : text + ". Unavailable: " + reason;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.toggled(!root.checked);
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.toggled(!root.checked);
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: focus.has-focus || root.checked ? Theme.accent : touch.has-hover ? Theme.text-muted : Theme.hairline-strong;
                background: root.checked ? Theme.accent : Theme.field;
                if root.checked: Icon {
                    source: @image-url("../../icons/check.svg");
                    tint: Theme.accent-ink;
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.text-body;
        }
    }
}

// A row of mutually exclusive views of one thing. The chosen one is filled and bold.
export component Segmented inherits Rectangle {
    in property <[{id: string, label: string}]> items;
    in property <string> current;
    callback picked(string);

    height: Theme.row;
    border-radius: Theme.radius;
    background: Theme.field;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for item in root.items: Rectangle {
            private property <bool> active: item.id == root.current;
            // Equal shares, whatever the labels measure: the row must not shift when the
            // chosen label turns bold.
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            border-radius: Theme.radius - 3px;
            border-width: focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            background: self.active ? Theme.surface-selected : touch.has-hover ? Theme.surface : transparent;
            accessible-role: tab;
            accessible-label: item.label;
            accessible-item-selected: self.active;
            accessible-action-default => {
                root.picked(item.id);
            }
            animate background { duration: Theme.quick; }

            focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.picked(item.id);
                        return accept;
                    }
                    return reject;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(item.id);
                }
            }

            Text {
                text: item.label;
                color: parent.active ? Theme.text : Theme.text-muted;
                font-size: Theme.text-body;
                font-weight: Theme.weight-medium;
            }
        }
    }
}

// A text field whose text Rust decides: `value` is applied when the field appears and whenever
// it changes. Rust mirrors every edit back into `value`, so setting it again always shows.
export component BoundField inherits TextField {
    in property <string> value;

    changed value => {
        self.text = self.value;
    }

    init => {
        self.text = self.value;
    }
}

// A drop-down list. Rust owns which entry is chosen (`index`) and hears about a pick; the
// field shows `model[index]` until Rust changes `index`.
export component Select inherits Rectangle {
    in property <[string]> model;
    in property <int> index;
    in property <string> label;
    in property <bool> enabled: true;
    callback picked(int);

    private property <length> menu-row: Theme.row;
    private property <bool> usable: root.enabled && root.model.length > 0;

    height: Theme.row;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : touch.has-hover && root.usable ? Theme.text-faint : Theme.hairline-strong;
    background: root.usable ? Theme.field : Theme.surface;
    opacity: root.usable ? 1 : 0.7;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.index >= 0 && root.index < root.model.length ? root.model[root.index] : "";
    accessible-enabled: root.usable;
    accessible-action-default => {
        if (root.usable) {
            menu.show();
        }
    }
    animate border-color { duration: Theme.quick; }

    focus := FocusScope {
        enabled: root.usable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                menu.show();
                return accept;
            }
            if (event.text == Key.UpArrow && root.index > 0) {
                root.picked(root.index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow && root.index < root.model.length - 1) {
                root.picked(root.index + 1);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            menu.show();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            vertical-alignment: center;
            text: root.index >= 0 && root.index < root.model.length ? root.model[root.index] : "";
            color: root.usable ? Theme.text : Theme.text-faint;
            font-size: Theme.text-body;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../../icons/chevron-down.svg");
                tint: Theme.text-muted;
            }
        }
    }

    menu := PopupWindow {
        x: 0;
        y: root.height + Theme.space-1;
        width: Math.max(root.width, 180px);
        height: Math.min(8, Math.max(1, root.model.length)) * root.menu-row + 2 * Theme.space-1;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.hairline-strong;
            background: Theme.surface;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #00000059;

            ListView {
                x: Theme.space-1;
                y: Theme.space-1;
                width: parent.width - 2 * Theme.space-1;
                height: parent.height - 2 * Theme.space-1;
                accessible-label: root.label;

                for entry[i] in root.model: Rectangle {
                    height: root.menu-row;
                    border-radius: Theme.radius - 3px;
                    background: row-touch.pressed ? Theme.surface-selected : row-touch.has-hover ? Theme.surface-hover : transparent;
                    accessible-role: list-item;
                    accessible-label: entry;
                    accessible-item-selected: i == root.index;
                    accessible-action-default => {
                        menu.close();
                        root.picked(i);
                    }

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.close();
                            root.picked(i);
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;

                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            vertical-alignment: center;
                            text: entry;
                            color: Theme.text;
                            font-size: Theme.text-body;
                            font-weight: i == root.index ? Theme.weight-medium : Theme.weight-regular;
                            overflow: elide;
                        }

                        if i == root.index: VerticalLayout {
                            alignment: center;
                            Icon {
                                source: @image-url("../../icons/check.svg");
                                tint: Theme.accent;
                            }
                        }
                    }
                }
            }
        }
    }
}
