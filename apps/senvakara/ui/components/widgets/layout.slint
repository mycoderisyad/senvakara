// Page layout: GroupTitle, Labeled, PageTitle, SectionHeader, EmptyState, PageToolbar, Card and
// CardGrid.

import { Theme } from "../../theme.slint";
import { Hint } from "status.slint";
import { SearchField } from "inputs.slint";
import { Icon, IconButton } from "../controls.slint";

// A section heading inside a page or panel ("Hosts", "Health", a host group).
export component GroupTitle inherits Text {
    color: Theme.text;
    font-size: Theme.text-body;
    font-weight: Theme.weight-strong;
}

// A label over a control, with what is wrong with it underneath, in words.
export component Labeled inherits VerticalLayout {
    in property <string> label;
    in property <string> error;
    alignment: start;
    spacing: Theme.space-1;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.text-small;
        font-weight: Theme.weight-medium;
    }

    @children

    if root.error != "": Hint {
        text: root.error;
        ink: Theme.danger;
    }
}

// The heading of a page section: a title and one sentence under it.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: start;
    spacing: Theme.space-1;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-title;
        font-weight: Theme.weight-strong;
    }

    if root.body != "": Hint {
        text: root.body;
    }
}

// A bordered block that groups one topic on a page.
export component Card inherits Rectangle {
    in property <length> pad: Theme.space-4;
    in property <length> gap: Theme.space-3;
    border-radius: Theme.radius;
    background: Theme.surface;
    height: content.preferred-height;

    content := VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

// Cards laid out in as many equal columns as fit.
export component CardGrid inherits Rectangle {
    in property <int> count;
    in property <length> min-card: 300px;
    out property <int> columns: Math.max(1, Math.floor((self.width + gap) / (min-card + gap)));
    out property <length> card-width: (self.width - (columns - 1) * gap) / columns;
    out property <length> gap: Theme.space-3;
    out property <length> row-height: 64px;

    pure public function card-x(index: int) -> length {
        return Math.mod(index, columns) * (card-width + gap);
    }

    pure public function card-y(index: int) -> length {
        return Math.floor(index / columns) * (row-height + gap);
    }

    height: count == 0 ? 0px : Math.ceil(count / columns) * (row-height + gap) - gap;
    @children
}

// A page heading with the line of state under it ("2 of 3 hosts reachable").
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    spacing: Theme.space-3;

    Text {
        vertical-alignment: center;
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-title;
        font-weight: Theme.weight-strong;
    }

    Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        text: root.detail;
        color: Theme.text-muted;
        font-size: Theme.text-small;
        overflow: elide;
    }
}

// What an empty list says. It carries no button: the action that fills the list is the first
// one in the page's `PageToolbar`, so it is in the same corner whether the list is empty or not.
export component EmptyState inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> body;

    height: content.preferred-height;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.hairline;

    content := VerticalLayout {
        padding: Theme.space-8;
        alignment: center;
        spacing: Theme.space-3;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: Theme.radius + 4px;
                background: Theme.surface;
                Icon {
                    width: 22px;
                    height: 22px;
                    source: root.icon;
                    tint: Theme.text-muted;
                }
            }
        }

        Text {
            horizontal-alignment: center;
            text: root.title;
            color: Theme.text;
            font-size: Theme.text-body + 2px;
            font-weight: Theme.weight-medium;
        }

        HorizontalLayout {
            alignment: center;
            Text {
                max-width: 420px;
                horizontal-alignment: center;
                text: root.body;
                color: Theme.text-muted;
                font-size: Theme.text-small;
                wrap: word-wrap;
            }
        }
    }
}

// The top of a page, the same single row everywhere: the page's own actions on the left (the
// children, with the filled "New ..." `ToolButton` first), then the search field if the page
// has one, and Refresh at the far right if the page has one; then a hairline.
export component PageToolbar inherits VerticalLayout {
    in property <bool> searchable;
    in-out property <string> query;
    in property <string> placeholder;
    // An action inside the search field ("Connect"); "" for none.
    in property <string> search-action;
    in property <bool> search-action-enabled;
    // What the Refresh button reloads, as its accessible name; "" for no Refresh button.
    in property <string> refresh-label;
    callback searched(string);
    // Enter in the search field, or a click on its action.
    callback search-accepted();
    callback refreshed();

    HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-2;

        @children

        if root.searchable: SearchField {
            min-width: 200px;
            preferred-width: 440px;
            max-width: 460px;
            horizontal-stretch: 10;
            text <=> root.query;
            placeholder: root.placeholder;
            action-label: root.search-action;
            action-enabled: root.search-action-enabled;
            edited(text) => {
                root.searched(text);
            }
            accepted => {
                root.search-accepted();
            }
            action-clicked => {
                root.search-accepted();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.refresh-label != "": IconButton {
            size: Theme.row;
            icon: @image-url("../../icons/refresh.svg");
            label: root.refresh-label;
            clicked => {
                root.refreshed();
            }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }
}
