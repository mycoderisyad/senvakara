// A workspace tab: one, two or four panels, each a live session, a picker for what to put
// there, or a sentence saying why its saved content cannot run. Rust owns the panels.

import { Theme } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";
import { Button, BoundField, Segmented, Select, Hint } from "widgets.slint";
import { PanelHost, PanelView } from "panel.slint";

// One saved workspace, as the Workspaces section lists it.
export struct WorkspaceItem {
    id: string,
    name: string,
    // "2 x 2"
    layout-text: string,
    // "PowerShell, SSH Fedora laptop, Logcat of 2201117PG"
    summary: string,
    // Open in a tab right now.
    open: bool,
}

export struct SlotView {
    // "empty" | "live" | "blocked"
    state: string,
    title: string,
    // The panel kind, for the header icon.
    kind: string,
    hue: int,
    // blocked: why the panel cannot run.
    reason: string,
    // blocked: connecting the host would fix it.
    can-connect: bool,
    connecting: bool,
    // empty: which entry of the picker is chosen.
    choice: int,
    panel: PanelView,
}

export global Workspaces {
    // The Workspaces section.
    in property <[WorkspaceItem]> saved;
    in property <string> error;
    callback open(id: string);
    callback remove(id: string);
    callback create();

    // The workspace tab on screen.
    in property <string> name;
    // "single" | "columns" | "grid"
    in property <string> layout: "columns";
    in property <[SlotView]> slots;
    // What an empty panel can become.
    in property <[string]> options;
    in property <string> save-label: "Save";
    // Why Save cannot be pressed ("" when it can).
    in property <string> save-reason;
    in property <bool> dirty;
    in property <string> message;
    in property <bool> message-ok;

    callback name-edited(text: string);
    callback set-layout(layout: string);
    callback save();
    callback choose(slot: int, index: int);
    callback add(slot: int);
    callback close-panel(slot: int);
    callback connect(slot: int);
}

component SlotFrame inherits Rectangle {
    in property <SlotView> slot;
    in property <int> index;
    private property <string> place: "panel " + (index + 1);

    background: Theme.ground;
    clip: true;

    VerticalLayout {
        if root.slot.state != "empty": Rectangle {
            height: 30px;
            background: Theme.shell;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-1;
                spacing: Theme.space-2;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: root.slot.kind == "mirror" ? @image-url("../icons/phone.svg") : root.slot.kind == "logcat" ? @image-url("../icons/list.svg") : root.slot.kind == "files" ? @image-url("../icons/folder.svg") : root.slot.kind == "desktop" ? @image-url("../icons/monitor.svg") : @image-url("../icons/terminal.svg");
                        tint: root.slot.state == "live" ? Theme.host-hue(root.slot.hue) : Theme.text-faint;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: root.slot.title;
                    color: root.slot.state == "live" ? Theme.text : Theme.text-muted;
                    font-size: Theme.text-small;
                    font-weight: Theme.weight-strong;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        size: 22px;
                        icon: @image-url("../icons/close.svg");
                        label: "Close " + root.slot.title + " in " + root.place;
                        clicked => {
                            Workspaces.close-panel(root.index);
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.hairline;
            }
        }

        if root.slot.state == "live": PanelHost {
            vertical-stretch: 1;
            panel: root.slot.panel;
            embedded: true;
        }

        if root.slot.state == "empty": Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                width: Math.min(360px, parent.width - 2 * Theme.space-4);
                alignment: center;
                spacing: Theme.space-2;

                Text {
                    text: "Empty panel";
                    color: Theme.text-muted;
                    font-size: Theme.text-small;
                    font-weight: Theme.weight-strong;
                }

                Select {
                    model: Workspaces.options;
                    index: root.slot.choice;
                    label: "What to show in " + root.place;
                    picked(choice) => {
                        Workspaces.choose(root.index, choice);
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Add";
                        kind: "primary";
                        accessible-label: "Add to " + root.place;
                        clicked => {
                            Workspaces.add(root.index);
                        }
                    }
                }
            }
        }

        if root.slot.state == "blocked": Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                width: Math.min(380px, parent.width - 2 * Theme.space-4);
                alignment: center;
                spacing: Theme.space-3;

                Hint {
                    text: root.slot.reason;
                    ink: Theme.text;
                }

                if root.slot.can-connect: HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-2;

                    Button {
                        text: root.slot.connecting ? "Connecting" : "Connect host";
                        enabled: !root.slot.connecting;
                        reason: root.slot.connecting ? "A connection attempt is running." : "";
                        accessible-label: "Connect host for " + root.place;
                        clicked => {
                            Workspaces.connect(root.index);
                        }
                    }

                    if root.slot.connecting: Text {
                        vertical-alignment: center;
                        text: "A connection attempt is running.";
                        color: Theme.text-faint;
                        font-size: Theme.text-small;
                    }
                }
            }
        }
    }
}

export component WorkspaceView inherits Rectangle {
    private property <int> columns: Workspaces.layout == "single" ? 1 : 2;
    private property <int> rows: Workspaces.layout == "grid" ? 2 : 1;

    background: Theme.ground;

    VerticalLayout {
        HorizontalLayout {
            height: 48px;
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;
                BoundField {
                    width: 240px;
                    value: Workspaces.name;
                    label: "Workspace name";
                    placeholder: "Workspace name";
                    edited(text) => {
                        Workspaces.name-edited(text);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Segmented {
                    width: 264px;
                    items: [
                        { id: "single", label: "1 panel" },
                        { id: "columns", label: "2 columns" },
                        { id: "grid", label: "2 x 2" },
                    ];
                    current: Workspaces.layout;
                    picked(id) => {
                        Workspaces.set-layout(id);
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                horizontal-alignment: right;
                text: Workspaces.save-reason != "" ? Workspaces.save-reason : Workspaces.message;
                color: Workspaces.save-reason != "" ? Theme.text-faint : Workspaces.message-ok ? Theme.text-muted : Theme.danger;
                font-size: Theme.text-small;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                Button {
                    text: Workspaces.save-label;
                    kind: Workspaces.dirty && Workspaces.save-reason == "" ? "primary" : "secondary";
                    enabled: Workspaces.save-reason == "";
                    reason: Workspaces.save-reason;
                    clicked => {
                        Workspaces.save();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        // The panels, with hairlines between them.
        grid := Rectangle {
            vertical-stretch: 1;
            background: Theme.hairline;
            private property <length> cell-w: (self.width - (root.columns - 1) * 1px) / root.columns;
            private property <length> cell-h: (self.height - (root.rows - 1) * 1px) / root.rows;

            for slot[index] in Workspaces.slots: SlotFrame {
                x: Math.mod(index, root.columns) * (grid.cell-w + 1px);
                y: Math.floor(index / root.columns) * (grid.cell-h + 1px);
                width: grid.cell-w;
                height: grid.cell-h;
                slot: slot;
                index: index;
            }
        }
    }
}
