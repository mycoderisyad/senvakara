// Buttons, fields, status marks and list cards shared by every screen.

import { ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";
import { Action, Meter, KeyValue } from "../data.slint";

// A text button. kind: "primary" | "secondary" | "danger" | "ghost".
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    // Why the button cannot be used; shown next to it by the caller and read by screen readers.
    in property <string> reason;
    callback clicked();

    private property <color> ink: !enabled ? Theme.text-faint : kind == "primary" ? Theme.accent-ink : kind == "danger" ? Theme.danger : Theme.text;
    private property <color> fill: kind == "primary" ? Theme.accent : kind == "ghost" ? transparent : Theme.surface;

    height: Theme.row;
    min-width: label.preferred-width + 2 * Theme.space-3;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : kind == "ghost" ? transparent : !enabled ? Theme.hairline : kind == "primary" ? transparent : Theme.hairline-strong;
    background: !enabled ? Theme.surface : touch.pressed ? fill.darker(0.15) : touch.has-hover ? fill.brighter(kind == "primary" ? 0.1 : 0.35) : fill;
    accessible-role: button;
    accessible-label: reason == "" ? text : text + ". Unavailable: " + reason;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (enabled) {
            root.clicked();
        }
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        color: root.ink;
        font-size: Theme.text-body;
        font-weight: root.kind == "primary" ? 600 : 500;
    }
}

// State as a shape plus a word, in a fixed cell so a column of them lines up.
// tone: "live" | "idle" | "busy" | "attention".
export component StatusMark inherits HorizontalLayout {
    in property <string> tone;
    in property <string> text;
    private property <color> ink: tone == "live" ? Theme.success : tone == "attention" ? Theme.warning : tone == "busy" ? Theme.info : Theme.text-faint;

    spacing: 6px;
    alignment: end;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            // live: filled dot. idle: ring. busy: half-filled ring. attention: filled square.
            border-radius: root.tone == "attention" ? 1px : 4px;
            border-width: root.tone == "idle" || root.tone == "busy" ? 1.5px : 0px;
            border-color: root.ink;
            background: root.tone == "live" || root.tone == "attention" ? root.ink : root.tone == "busy" ? root.ink.with-alpha(0.45) : transparent;
        }
    }

    Text {
        vertical-alignment: center;
        text: root.text;
        color: root.tone == "idle" ? Theme.text-muted : root.ink;
        font-size: Theme.text-small;
        overflow: elide;
    }
}

export component MeterRow inherits VerticalLayout {
    in property <Meter> meter;
    private property <color> ink: meter.fraction > 0.9 ? Theme.danger : meter.fraction > 0.75 ? Theme.warning : Theme.accent;

    spacing: 4px;

    HorizontalLayout {
        Text {
            text: root.meter.label;
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        Text {
            horizontal-alignment: right;
            text: root.meter.value;
            color: Theme.text;
            font-size: Theme.text-small;
        }
    }

    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.hairline;
        Rectangle {
            x: 0;
            width: parent.width * Math.clamp(root.meter.fraction, 0, 1);
            border-radius: 2px;
            background: root.ink;
            animate width { duration: 240ms; easing: ease-out; }
        }
    }
}

export component DetailRow inherits HorizontalLayout {
    in property <KeyValue> item;
    spacing: Theme.space-3;

    Text {
        width: 104px;
        text: root.item.key;
        color: Theme.text-muted;
        font-size: Theme.text-small;
        vertical-alignment: top;
    }

    Text {
        text: root.item.value;
        color: Theme.text;
        font-size: Theme.text-small;
        font-family: root.item.mono ? Theme.mono : Theme.sans;
        wrap: root.item.mono ? char-wrap : word-wrap;
        horizontal-stretch: 1;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    height: 34px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../icons/search.svg");
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.text-body;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                single-line: true;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.text-body;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.placeholder;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }
}

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> badge;
    in property <bool> active;
    callback clicked();

    height: Theme.row;
    border-radius: Theme.radius;
    background: active ? Theme.surface-selected : touch.has-hover || focus.has-focus ? Theme.surface : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: active;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.active ? Theme.accent : Theme.text-muted;
            }
        }

        Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: root.text;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.text-body;
            font-weight: root.active ? 600 : 400;
        }

        if root.badge != "": Text {
            vertical-alignment: center;
            text: root.badge;
            color: Theme.text-faint;
            font-size: Theme.text-small;
        }
    }
}

// A two-line list card: icon tile, name, route or address, state in a fixed right-hand cell.
export component ItemCard inherits Rectangle {
    in property <image> icon;
    in property <color> hue: Theme.accent;
    in property <string> title;
    in property <string> subtitle;
    in property <string> tone;
    in property <string> state-text;
    in property <bool> selected;
    in property <[Action]> actions;
    callback select();
    callback open();
    callback action(string);

    height: 56px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: selected || focus.has-focus ? Theme.accent : Theme.hairline;
    background: selected ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: title + ", " + subtitle + ", " + state-text;
    accessible-item-selected: selected;
    accessible-action-default => {
        root.open();
    }
    animate background { duration: Theme.quick; }

    ContextMenuArea {
        Menu {
            for entry in root.actions: MenuItem {
                title: entry.label;
                enabled: entry.reason == "";
                activated => {
                    root.action(entry.id);
                }
            }
        }

        focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return) {
                    root.open();
                    return accept;
                }
                if (event.text == " ") {
                    root.select();
                    return accept;
                }
                return reject;
            }
        }

        touch := TouchArea {
            clicked => {
                focus.focus();
                root.select();
            }
            double-clicked => {
                root.open();
            }
        }

        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius;
                    background: root.hue.with-alpha(0.16);
                    Icon {
                        source: root.icon;
                        tint: root.hue;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.text-body;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text-muted;
                    font-size: Theme.text-small;
                    overflow: elide;
                }
            }

            StatusMark {
                width: 132px;
                tone: root.tone;
                text: root.state-text;
            }
        }
    }
}

export component GroupTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.text-small;
    font-weight: 600;
}

export component Notice inherits Rectangle {
    in property <string> text;
    // "danger" | "warning" | "info" | "success"
    in property <string> kind: "warning";
    private property <color> ink: kind == "danger" ? Theme.danger : kind == "info" ? Theme.info : kind == "success" ? Theme.success : Theme.warning;

    border-radius: Theme.radius;
    background: ink.with-alpha(0.1);
    // Sized from its own width, not through a layout: a message with one very long word (a
    // path, an address) must be cut, not widen the panel it sits in.
    height: body.preferred-height + 2 * Theme.space-2;
    clip: true;

    body := Text {
        x: Theme.space-3;
        y: Theme.space-2;
        width: parent.width - 2 * Theme.space-3;
        text: root.text;
        color: root.ink;
        font-size: Theme.text-small;
        wrap: word-wrap;
    }
}

// A one-line text field. `label` is its accessible name.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> mono;
    // Hide what is typed (a passphrase).
    in property <bool> secret;
    callback edited(string);
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    height: Theme.row;
    min-width: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline-strong;
    background: enabled ? Theme.ground : Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.text-body;
                font-family: root.mono ? Theme.mono : Theme.sans;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                input-type: root.secret ? InputType.password : InputType.text;
                text <=> root.text;
                color: root.enabled ? Theme.text : Theme.text-faint;
                font-size: Theme.text-body;
                font-family: root.mono ? Theme.mono : Theme.sans;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.label == "" ? root.placeholder : root.label;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }
}

// A check box with its label. The mark is a shape, not only a colour.
export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Why the box cannot be changed; the caller shows it next to the box.
    in property <string> reason;
    callback toggled(bool);

    height: Theme.row;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    accessible-role: checkbox;
    accessible-label: enabled || reason == "" ? text : text + ". Unavailable: " + reason;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.toggled(!root.checked);
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.toggled(!root.checked);
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-1;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: focus.has-focus || root.checked ? Theme.accent : touch.has-hover ? Theme.text-muted : Theme.hairline-strong;
                background: root.checked ? Theme.accent : Theme.ground;
                if root.checked: Icon {
                    source: @image-url("../icons/check.svg");
                    tint: Theme.accent-ink;
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.text-body;
        }
    }
}

// A row of mutually exclusive views of one thing. The chosen one is filled and bold.
export component Segmented inherits Rectangle {
    in property <[{id: string, label: string}]> items;
    in property <string> current;
    callback picked(string);

    height: Theme.row;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.surface;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for item in root.items: Rectangle {
            private property <bool> active: item.id == root.current;
            // Equal shares, whatever the labels measure: the row must not shift when the
            // chosen label turns bold.
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            border-radius: Theme.radius - 2px;
            border-width: focus.has-focus ? 1px : 0px;
            border-color: Theme.accent;
            background: self.active ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: tab;
            accessible-label: item.label;
            accessible-item-selected: self.active;
            accessible-action-default => {
                root.picked(item.id);
            }
            animate background { duration: Theme.quick; }

            focus := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.picked(item.id);
                        return accept;
                    }
                    return reject;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(item.id);
                }
            }

            Text {
                text: item.label;
                color: parent.active ? Theme.text : Theme.text-muted;
                font-size: Theme.text-small;
                font-weight: parent.active ? 600 : 400;
            }
        }
    }
}

// A thin bar for progress that is known as a fraction.
export component ProgressBar inherits Rectangle {
    in property <float> fraction;
    in property <color> ink: Theme.accent;

    height: 4px;
    border-radius: 2px;
    background: Theme.hairline;

    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.fraction, 0, 1);
        border-radius: 2px;
        background: root.ink;
        animate width { duration: 160ms; easing: ease-out; }
    }
}

// Why a control next to this line cannot be used. Draws nothing when there is no reason.
export component Reason inherits Text {
    visible: self.text != "";
    height: self.text == "" ? 0px : self.preferred-height;
    color: Theme.text-faint;
    font-size: Theme.text-small;
    wrap: word-wrap;
}

// One action as a button, with the reason underneath when it cannot be used. Sized by hand:
// a wrapped line inside nested layouts is otherwise measured too short and overlaps what follows.
component ActionRow inherits Rectangle {
    in property <Action> entry;
    in property <bool> primary;
    callback run();

    height: button.height + (entry.reason == "" ? 0px : reason.preferred-height + 2px);

    button := Button {
        x: 0;
        y: 0;
        width: parent.width;
        text: root.entry.label;
        kind: root.primary ? "primary" : root.entry.danger ? "danger" : "secondary";
        enabled: root.entry.reason == "";
        reason: root.entry.reason;
        clicked => {
            root.run();
        }
    }

    reason := Text {
        x: 0;
        y: button.height + 2px;
        width: parent.width;
        visible: root.entry.reason != "";
        text: root.entry.reason;
        color: root.primary ? Theme.text-muted : Theme.text-faint;
        font-size: Theme.text-small;
        wrap: word-wrap;
    }
}

// Buttons for every action of the selected item; an unavailable one says why underneath.
// `primary` must be one of `actions`: it is drawn as the filled button.
export component ActionList inherits VerticalLayout {
    in property <Action> primary;
    in property <[Action]> actions;
    callback run(string);

    spacing: Theme.space-2;

    for entry in root.actions: ActionRow {
        entry: entry;
        primary: entry.id == root.primary.id;
        run => {
            root.run(entry.id);
        }
    }
}

// A text field whose text Rust decides: `value` is applied when the field appears and whenever
// it changes. Rust mirrors every edit back into `value`, so setting it again always shows.
export component BoundField inherits TextField {
    in property <string> value;

    changed value => {
        self.text = self.value;
    }

    init => {
        self.text = self.value;
    }
}

// A drop-down list. Rust owns which entry is chosen (`index`) and hears about a pick.
export component Select inherits Rectangle {
    in property <[string]> model;
    in property <int> index;
    in property <string> label;
    in property <bool> enabled: true;
    callback picked(int);

    height: Theme.row;
    min-width: 120px;
    horizontal-stretch: 1;

    changed index => {
        combo.current-index = root.index;
    }

    init => {
        combo.current-index = root.index;
    }

    combo := ComboBox {
        width: 100%;
        height: 100%;
        model: root.model;
        enabled: root.enabled;
        accessible-label: root.label;
        selected => {
            root.picked(self.current-index);
        }
    }
}

// A wrapped line of help or of what is wrong. Sized from its own width, not through the layout:
// a wrapped Text inside nested layouts is otherwise measured as a single line.
export component Hint inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-muted;
    in property <bool> mono;

    height: body.preferred-height;

    body := Text {
        x: 0;
        y: 0;
        width: parent.width;
        text: root.text;
        color: root.ink;
        font-size: Theme.text-small;
        font-family: root.mono ? Theme.mono : Theme.sans;
        wrap: root.mono ? char-wrap : word-wrap;
    }
}

// A label over a control, with what is wrong with it underneath, in words.
export component Labeled inherits VerticalLayout {
    in property <string> label;
    in property <string> error;
    alignment: start;
    spacing: Theme.space-1;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.text-small;
    }

    @children

    if root.error != "": Hint {
        text: root.error;
        ink: Theme.danger;
    }
}

// The heading of a page section: a title and one sentence under it.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: start;
    spacing: Theme.space-1;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-title;
        font-weight: 600;
    }

    if root.body != "": Hint {
        text: root.body;
    }
}

// A bordered block that groups one topic on a page.
export component Card inherits Rectangle {
    in property <length> pad: Theme.space-4;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.surface;
    height: content.preferred-height;

    content := VerticalLayout {
        padding: root.pad;
        spacing: Theme.space-3;
        @children
    }
}
