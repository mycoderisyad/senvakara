// The Files tab: two file lists side by side, each showing this PC, a host or a phone, or the
// invitation to choose a host. Rust lists folders, keeps the selection and decides what can be
// copied; the files in files-view/ draw one side and forward clicks, keys and drops.

import { Theme } from "../theme.slint";
import { JobList, Jobs } from "jobs.slint";
import { Files, FileRow, FileSide, FileCrumb, FilePlace, FilesData } from "files-view/data.slint";
import { FilePane } from "files-view/pane.slint";

export { Files, FileRow, FileSide, FileCrumb, FilePlace, FilesData }

export component FilesView inherits Rectangle {
    in property <FilesData> data;
    // Inside a workspace panel: the activity list stays on Home.
    in property <bool> embedded;
    // Too narrow for two lists: show the right-hand one (the host or phone) alone.
    private property <bool> narrow: self.width < 720px;

    background: Theme.ground;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            if !root.narrow: FilePane {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                pane: root.data.id;
                side: 0;
                room: root.width / 2;
                info: root.data.sides[0];
                rows: root.data.left-rows;
                crumbs: root.data.left-crumbs;
                places: root.data.left-places;
            }

            if !root.narrow: Rectangle {
                width: 1px;
                background: Theme.hairline;
            }

            FilePane {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                pane: root.data.id;
                side: 1;
                alone: root.narrow;
                room: root.narrow ? root.width : root.width / 2;
                info: root.data.sides[1];
                rows: root.data.right-rows;
                crumbs: root.data.right-crumbs;
                places: root.data.right-places;
            }
        }

        // Copies in progress stay in view next to the folders they touch.
        if !root.embedded && Jobs.items.length > 0: JobList { }
    }
}
