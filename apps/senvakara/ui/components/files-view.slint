// The Files tab: two file lists side by side, each showing this PC, a host or a phone. Rust
// lists folders, keeps the selection and decides what can be copied; this file draws the rows
// and forwards clicks and keys.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";
import { Button, Notice, TextField, Select } from "widgets.slint";
import { JobList } from "jobs.slint";
import { Jobs } from "../data.slint";

export struct FileRow {
    name: string,
    // "folder" | "file" | "drive"
    kind: string,
    // A symbolic link: marked with the word "link" after the name.
    link: bool,
    // "1.5 MB"; empty for folders.
    size: string,
    // "2026-11-21 14:05" in local time; empty when the place does not say.
    modified: string,
    selected: bool,
}

export struct FileSide {
    // "This PC", the host's name or the phone's name.
    place: string,
    // The folder on screen.
    path: string,
    can-up: bool,
    loading: bool,
    // A listing has been shown for this place.
    loaded: bool,
    error: string,
    // "12 items, 2 selected (3.4 MB)"
    summary: string,
    // Why the selection cannot be copied to the other side ("" when it can).
    copy-reason: string,
    // "To Fedora laptop: /tmp"
    copy-target: string,
    // The row the keyboard is on, -1 for none.
    cursor: int,
    // Exactly one row is selected and it can be opened.
    can-open: bool,
    // Which of the places the picker shows.
    source-index: int,
    // What the folder field should say; applied whenever it or `input-rev` changes.
    input: string,
    input-rev: int,
}

// What one Files pane shows; `id` names the pane in every callback.
//
// This struct is only set when the view starts showing a pane; what changes afterwards arrives
// through its models. Setting it again would mark the row bindings dirty, and a row change
// (a selection) that arrives while they are dirty is not drawn.
export struct FilesData {
    id: int,
    // The places a side can show, for both pickers.
    sources: [string],
    // Two rows: left, right.
    sides: [FileSide],
    left-rows: [FileRow],
    right-rows: [FileRow],
}

export global Files {
    // side: 0 left, 1 right.
    callback pick-source(id: int, side: int, index: int);
    callback go(id: int, side: int, path: string);
    callback up(id: int, side: int);
    callback refresh(id: int, side: int);
    callback open(id: int, side: int, row: int);
    callback select(id: int, side: int, row: int, control: bool, shift: bool);
    callback key(id: int, side: int, text: string, control: bool, shift: bool) -> bool;
    callback copy(id: int, side: int);
}

component HeaderCell inherits Text {
    vertical-alignment: center;
    color: Theme.text-muted;
    font-size: Theme.text-small;
    font-weight: 600;
}

component FilePane inherits Rectangle {
    in property <int> pane;
    in property <int> side;
    in property <FileSide> info;
    in property <[FileRow]> rows;
    in property <[string]> sources;
    // Only this side is on screen (a narrow workspace panel): nothing can be copied across.
    in property <bool> alone;
    // Rust decides what the folder field says: after a listing, and when another pane is shown.
    private property <string> input-key: pane + "/" + info.input-rev + "/" + info.input;

    changed input-key => {
        field.text = info.input;
    }

    init => {
        field.text = info.input;
    }

    private property <string> side-name: side == 0 ? "left" : "right";
    private property <length> row-height: 28px;
    private property <length> size-width: 76px;
    private property <length> time-width: 118px;
    private property <int> cursor: info.cursor;

    // Keep the row the keyboard is on in view.
    changed cursor => {
        if (cursor >= 0) {
            if (cursor * row-height < -list.content-y) {
                list.content-y = -cursor * row-height;
            } else if ((cursor + 1) * row-height > list.visible-height - list.content-y) {
                list.content-y = list.visible-height - (cursor + 1) * row-height;
            }
        }
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Select {
            model: root.sources;
            index: root.info.source-index;
            label: "Place shown on the " + root.side-name + " side";
            picked(index) => {
                Files.pick-source(root.pane, root.side, index);
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/up.svg");
                    label: "Up one folder, " + root.side-name + " side";
                    enabled: root.info.can-up;
                    clicked => {
                        Files.up(root.pane, root.side);
                    }
                }
            }

            field := TextField {
                horizontal-stretch: 1;
                mono: true;
                label: "Folder on the " + root.side-name + " side";
                placeholder: root.info.loaded ? root.info.path : "Folder path";
                accepted => {
                    Files.go(root.pane, root.side, self.text);
                }
            }

            Button {
                text: "Go";
                accessible-label: "Go to the typed folder, " + root.side-name + " side";
                clicked => {
                    Files.go(root.pane, root.side, field.text);
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/refresh.svg");
                    label: "Refresh the " + root.side-name + " side";
                    clicked => {
                        Files.refresh(root.pane, root.side);
                    }
                }
            }
        }

        if root.info.error != "": Notice {
            kind: "danger";
            text: root.info.error;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: keys.has-focus ? Theme.accent : Theme.hairline;
            background: Theme.surface;
            clip: true;

            VerticalLayout {
                padding: 1px;

                HorizontalLayout {
                    height: root.row-height;
                    padding-left: Theme.space-2 + 16px + Theme.space-2;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;

                    HeaderCell {
                        horizontal-stretch: 1;
                        text: "Name";
                    }

                    HeaderCell {
                        width: root.size-width;
                        horizontal-alignment: right;
                        text: "Size";
                    }

                    HeaderCell {
                        width: root.time-width;
                        text: "Modified";
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.hairline;
                }

                ContextMenuArea {
                    vertical-stretch: 1;

                    Menu {
                        MenuItem {
                            title: "Open";
                            enabled: root.info.can-open;
                            activated => {
                                Files.open(root.pane, root.side, root.info.cursor);
                            }
                        }

                        MenuItem {
                            title: "Copy to other side";
                            enabled: root.info.copy-reason == "";
                            activated => {
                                Files.copy(root.pane, root.side);
                            }
                        }

                        MenuItem {
                            title: "Up one folder";
                            enabled: root.info.can-up;
                            activated => {
                                Files.up(root.pane, root.side);
                            }
                        }

                        MenuItem {
                            title: "Refresh";
                            activated => {
                                Files.refresh(root.pane, root.side);
                            }
                        }
                    }

                    keys := FocusScope {
                        key-pressed(event) => {
                            return Files.key(root.pane, root.side, event.text, event.modifiers.control, event.modifiers.shift) ? accept : reject;
                        }

                        list := ListView {
                            accessible-label: "Files on the " + root.side-name + " side";

                            for row[index] in root.rows: Rectangle {
                                height: root.row-height;
                                background: row.selected ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
                                accessible-role: list-item;
                                accessible-label: row.name + (row.link ? ", link" : "") + ", " + (row.kind == "file" ? row.size : row.kind);
                                accessible-item-selected: row.selected;
                                accessible-action-default => {
                                    Files.select(root.pane, root.side, index, false, false);
                                }

                                touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            keys.focus();
                                            Files.select(root.pane, root.side, index, event.modifiers.control, event.modifiers.shift);
                                        } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && !row.selected) {
                                            // The menu acts on what is selected: a right-click on another row selects it first.
                                            keys.focus();
                                            Files.select(root.pane, root.side, index, false, false);
                                        }
                                    }
                                    double-clicked => {
                                        Files.open(root.pane, root.side, index);
                                    }
                                }

                                // The row the keyboard is on.
                                if index == root.info.cursor && keys.has-focus: Rectangle {
                                    x: 0;
                                    width: 2px;
                                    background: Theme.accent;
                                }

                                HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: row.kind == "folder" ? @image-url("../icons/folder.svg") : row.kind == "drive" ? @image-url("../icons/drive.svg") : @image-url("../icons/file.svg");
                                            tint: row.kind == "file" ? Theme.text-faint : Theme.text-muted;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        text: row.name;
                                        color: Theme.text;
                                        font-size: Theme.text-body;
                                        overflow: elide;
                                    }

                                    if row.link: Text {
                                        vertical-alignment: center;
                                        text: "link";
                                        color: Theme.text-faint;
                                        font-size: Theme.text-small;
                                    }

                                    Text {
                                        width: root.size-width;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        text: row.size;
                                        color: Theme.text-muted;
                                        font-size: Theme.text-small;
                                    }

                                    Text {
                                        width: root.time-width;
                                        vertical-alignment: center;
                                        text: row.modified;
                                        color: Theme.text-muted;
                                        font-size: Theme.text-small;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        if root.rows.length == 0: Text {
                            width: parent.width - 2 * Theme.space-4;
                            horizontal-alignment: center;
                            text: root.info.loading ? "Reading " + root.info.place : root.info.error != "" ? "Nothing to show" : root.info.loaded ? "This folder is empty" : "No folder open";
                            color: Theme.text-muted;
                            font-size: Theme.text-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.alone: Text {
            text: root.info.loading && root.rows.length > 0 ? "Reading " + root.info.place : root.info.summary == "" ? "Widen the panel to see this PC next to it and copy files across." : root.info.summary + ". Widen the panel to copy files to or from this PC.";
            color: Theme.text-muted;
            font-size: Theme.text-small;
            overflow: elide;
        }

        if !root.alone: HorizontalLayout {
            spacing: Theme.space-2;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.info.loading && root.rows.length > 0 ? "Reading " + root.info.place : root.info.summary;
                    color: Theme.text-muted;
                    font-size: Theme.text-small;
                    overflow: elide;
                }

                Text {
                    text: root.info.copy-target;
                    color: Theme.text-faint;
                    font-size: Theme.text-small;
                    font-family: Theme.mono;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Button {
                    text: "Copy to other side";
                    kind: root.info.copy-reason == "" ? "primary" : "secondary";
                    enabled: root.info.copy-reason == "";
                    reason: root.info.copy-reason;
                    accessible-label: root.info.copy-reason == "" ? "Copy to other side, from the " + root.side-name : "Copy to other side, from the " + root.side-name + ". Unavailable: " + root.info.copy-reason;
                    clicked => {
                        Files.copy(root.pane, root.side);
                    }
                }
            }
        }

        // Always one line high at least, so both lists keep the same height.
        if !root.alone: Rectangle {
            height: Math.max(16px, reason.preferred-height);
            reason := Text {
                x: 0;
                y: 0;
                width: parent.width;
                horizontal-alignment: right;
                text: root.info.copy-reason;
                color: Theme.text-faint;
                font-size: Theme.text-small;
                wrap: word-wrap;
            }
        }
    }
}

export component FilesView inherits Rectangle {
    in property <FilesData> data;
    // Inside a workspace panel: the activity list stays on Home.
    in property <bool> embedded;
    // Too narrow for two lists: show the right-hand one (the host or phone) alone.
    private property <bool> narrow: self.width < 720px;

    background: Theme.ground;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            if !root.narrow: FilePane {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                pane: root.data.id;
                side: 0;
                info: root.data.sides[0];
                rows: root.data.left-rows;
                sources: root.data.sources;
            }

            if !root.narrow: Rectangle {
                width: 1px;
                background: Theme.hairline;
            }

            FilePane {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                pane: root.data.id;
                side: 1;
                alone: root.narrow;
                info: root.data.sides[1];
                rows: root.data.right-rows;
                sources: root.data.sources;
            }
        }

        // Copies in progress stay in view next to the folders they touch.
        if !root.embedded && Jobs.items.length > 0: JobList { }
    }
}
