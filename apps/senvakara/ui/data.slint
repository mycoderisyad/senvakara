// View models the Rust side fills in. All filtering, sorting and wording happens in Rust;
// the .slint files only draw these and forward what the user did.

export struct KeyValue {
    key: string,
    value: string,
    // Shown in the monospace face (paths, fingerprints, serials).
    mono: bool,
}

export struct Meter {
    label: string,
    value: string,
    // 0..1
    fraction: float,
}

// One thing the user can do to a host or device. `reason` is set when it is unavailable.
export struct Action {
    id: string,
    label: string,
    reason: string,
    danger: bool,
}

// One address a host can be reached at.
export struct PathItem {
    // The VPN endpoint, or "" for the host's main address (which cannot be removed here).
    id: string,
    // "LAN" | "VPN"
    kind: string,
    // "192.0.2.10:22"
    address: string,
    // The live connection goes through this address.
    in-use: bool,
}

// A VPN address the host itself reported, offered for one-click adding.
export struct VpnHint {
    // "Add wg0 10.8.0.3"
    label: string,
    address: string,
}

export struct HostItem {
    id: string,
    name: string,
    subtitle: string,
    // "windows" | "linux"
    os: string,
    hue: int,
    // "live" | "idle" | "busy" | "attention"
    tone: string,
    state-text: string,
    primary: Action,
    actions: [Action],
    details: [KeyValue],
    meters: [Meter],
    meters-note: string,
    paths: [PathItem],
    // Why the connection is not on the first address, when the backend says so.
    path-note: string,
    vpn-hints: [VpnHint],
    error: string,
}

export struct DeviceItem {
    id: string,
    name: string,
    // "RAFGT > USB": the route trail, host first.
    route: string,
    host-hue: int,
    tone: string,
    state-text: string,
    primary: Action,
    actions: [Action],
    details: [KeyValue],
    hint: string,
}

export global Inventory {
    in property <[HostItem]> hosts;
    in property <[DeviceItem]> devices;
    in property <[KeyValue]> adb-sources;
    in property <string> summary;
    in property <bool> loading;
    in property <string> error;
    in-out property <string> query;
    // "" | "host" | "device"
    in-out property <string> selected-kind;
    in-out property <string> selected-id;
    in property <HostItem> selected-host;
    in property <DeviceItem> selected-device;

    callback search(text: string);
    callback select(kind: string, id: string);
    callback host-action(id: string, action: string);
    callback device-action(id: string, action: string);
    callback add-host();
    callback add-wireless();
    callback refresh();
}

// Add or edit a remote host. Shown in the inspector instead of the details while open.
export global HostForm {
    in property <bool> open;
    // "New host" | "Edit Fedora laptop"
    in property <string> title;
    in property <bool> editing;
    in-out property <string> name;
    in-out property <string> address;
    in-out property <string> port;
    in-out property <string> username;
    // "linux" | "unknown"
    in property <string> os: "linux";
    in-out property <string> key-path;
    in-out property <string> passphrase;
    // A passphrase is stored for this host already.
    in property <bool> has-passphrase;
    in property <bool> remove-passphrase;
    // What is wrong with a field, in words ("" when it is fine).
    in property <string> name-error;
    in property <string> address-error;
    in property <string> port-error;
    in property <string> username-error;
    in property <string> key-error;
    // Why saving failed.
    in property <string> error;
    in property <bool> saving;
    // Bumped whenever the form is (re)opened: the first field takes the cursor.
    in property <int> revision;

    callback edited();
    callback set-os(os: string);
    callback set-remove-passphrase(on: bool);
    callback browse();
    callback save();
    callback cancel();
}

// Adding a VPN address to the host selected on Home. The addresses themselves are in HostItem.
export global NetPaths {
    in-out property <string> address;
    in-out property <string> port;
    // Why Add cannot be pressed ("" when it can).
    in property <string> add-reason;
    in property <string> error;

    callback edited();
    callback add();
    callback add-hint(address: string);
    callback remove(endpoint-id: string);
}

// The tools of the device inspector. They always act on the phone selected on Home; Rust clears
// them when another phone is selected.
export global DeviceTools {
    // "overview" | "shell" | "apps" | "screen"
    in property <string> tab: "overview";
    // Why the tools cannot be used ("" when the phone is connected and authorized).
    in property <string> blocked;
    // Something on the overview went wrong, already worded for the user.
    in property <string> message;

    in property <bool> renaming;
    in-out property <string> rename-text;

    in property <bool> info-busy;
    in property <[KeyValue]> props;

    in-out property <string> command;
    in property <bool> shell-busy;
    // A command has run and its result is shown.
    in property <bool> shell-ran;
    in property <string> shell-note;
    in property <string> shell-output;
    in property <string> shell-error;

    in property <[string]> packages;
    in property <bool> apps-busy;
    in property <bool> apps-loaded;
    in property <string> apps-note;
    in property <string> apps-error;

    in property <image> shot;
    in property <int> shot-width;
    in property <int> shot-height;
    in property <bool> shot-busy;
    in property <string> shot-note;
    // Where the screenshot was saved, shown under the note.
    in property <string> shot-path;
    in property <string> shot-error;

    callback show-tab(tab: string);
    callback run-shell();
    callback copy-output();
    callback load-apps();
    callback install();
    callback uninstall(package: string);
    callback take-shot();
    callback save-shot();
    callback rename-save();
    callback rename-cancel();
}

// One transfer or install.
export struct JobItem {
    id: int,
    label: string,
    // "running" | "done" | "failed" | "cancelled"
    state: string,
    // "42 %", "Starting", "Done", ...
    state-text: string,
    // 0..1
    fraction: float,
    // Where the result went.
    detail: string,
    error: string,
}

export global Jobs {
    in property <[JobItem]> items;
    in property <bool> has-finished;
    callback cancel(id: int);
    callback dismiss(id: int);
    callback clear-finished();
}

// A phone advertising Wireless debugging.
export struct WirelessService {
    address: string,
    // "Pairing screen open" | "Ready to connect"
    state: string,
    name: string,
}

export struct WirelessNote {
    ok: bool,
    text: string,
}

// The "Add over Wi-Fi" dialog.
export global Wireless {
    in property <bool> open;
    // Hosts whose ADB is being watched.
    in property <[string]> host-names;
    in-out property <int> host-index;
    // Why nothing can be done at all ("" when a host is available).
    in property <string> host-reason;
    in property <[WirelessService]> found;
    // A scan of the chosen host has finished.
    in property <bool> scanned;
    in-out property <string> pair-address;
    in-out property <string> code;
    in-out property <string> connect-address;
    // Why Pair or Connect cannot be pressed yet ("" when it can).
    in property <string> pair-reason;
    in property <string> connect-reason;
    // "" | "scan" | "pair" | "connect"
    in property <string> busy;
    // Newest first.
    in property <[WirelessNote]> log;

    callback host-changed(index: int);
    // A field changed: Rust tidies the code and refreshes the reasons.
    callback edited();
    callback scan();
    callback pair();
    callback connect();
    callback close();
}
