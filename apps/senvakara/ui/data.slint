// View models the Rust side fills in. All filtering, sorting and wording happens in Rust;
// the .slint files only draw these and forward what the user did.
//
// Only what several views share lives here: the inventory and the small structs. A global
// that one view owns is declared in that view's file, next to the component that draws it.

export struct KeyValue {
    key: string,
    value: string,
    // Shown in the monospace face (paths, fingerprints, serials).
    mono: bool,
}

export struct Meter {
    label: string,
    value: string,
    // 0..1
    fraction: float,
}

// One thing the user can do to a host or device. `reason` is set when it is unavailable.
export struct Action {
    id: string,
    label: string,
    reason: string,
    danger: bool,
}

// One address a host can be reached at.
export struct PathItem {
    // The VPN endpoint, or "" for the host's main address (which cannot be removed here).
    id: string,
    // "LAN" | "VPN"
    kind: string,
    // "192.0.2.10:22"
    address: string,
    // The live connection goes through this address.
    in-use: bool,
}

// A VPN address the host itself reported, offered for one-click adding.
export struct VpnHint {
    // "Add wg0 10.8.0.3"
    label: string,
    address: string,
}

export struct HostItem {
    id: string,
    name: string,
    subtitle: string,
    // "windows" | "linux" | "rdp" (a Remote Desktop host): which icon the card shows.
    os: string,
    hue: int,
    // "live" | "idle" | "busy" | "attention"
    tone: string,
    state-text: string,
    primary: Action,
    actions: [Action],
    details: [KeyValue],
    meters: [Meter],
    meters-note: string,
    paths: [PathItem],
    // Why the connection is not on the first address, when the backend says so.
    path-note: string,
    vpn-hints: [VpnHint],
    error: string,
}

// The hosts filed under one parent group, in the order Home shows them.
export struct HostGroup {
    // "Hosts" for the hosts without a group.
    name: string,
    hosts: [HostItem],
}

export struct DeviceItem {
    id: string,
    name: string,
    // "RAFGT > USB": the route trail, host first.
    route: string,
    host-hue: int,
    tone: string,
    state-text: string,
    primary: Action,
    actions: [Action],
    details: [KeyValue],
    hint: string,
}

export global Inventory {
    in property <[HostItem]> hosts;
    // The same hosts by parent group: ungrouped ones first, then the groups by name.
    in property <[HostGroup]> host-groups;
    in property <[DeviceItem]> devices;
    in property <[KeyValue]> adb-sources;
    in property <string> summary;
    in property <bool> loading;
    in property <string> error;
    in-out property <string> query;
    // The query parses as an SSH target (`ssh user@host` or `user@host`).
    in property <bool> can-connect;
    in property <string> connect-target;
    // "" | "host" | "device"
    in-out property <string> selected-kind;
    in-out property <string> selected-id;
    in property <HostItem> selected-host;
    in property <DeviceItem> selected-device;

    callback search(text: string);
    callback quick-connect();
    callback select(kind: string, id: string);
    callback host-action(id: string, action: string);
    callback device-action(id: string, action: string);
    callback add-host();
    callback add-wireless();
    callback refresh();
}
