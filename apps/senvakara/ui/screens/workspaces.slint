// The Workspaces section of Home: saved layouts, each opened as a session tab.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "../components/controls.slint";
import { Button, Notice, PageTitle } from "../components/widgets.slint";
import { Workspaces, WorkspaceItem } from "../components/workspace-view.slint";

component WorkspaceRow inherits Rectangle {
    in property <WorkspaceItem> item;

    height: 56px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.hairline;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: list-item;
    accessible-label: item.name + ", " + item.layout-text + ", " + item.summary;
    accessible-action-default => {
        Workspaces.open(item.id);
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return) {
                Workspaces.open(root.item.id);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            focus.focus();
        }
        double-clicked => {
            Workspaces.open(root.item.id);
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.radius;
                background: Theme.accent.with-alpha(0.16);
                Icon {
                    source: @image-url("../icons/layout.svg");
                    tint: Theme.accent;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.item.open ? root.item.name + "  (open)" : root.item.name;
                color: Theme.text;
                font-size: Theme.text-body;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.layout-text + "  ·  " + root.item.summary;
                color: Theme.text-muted;
                font-size: Theme.text-small;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: root.item.open ? "Show" : "Open";
                accessible-label: (root.item.open ? "Show workspace " : "Open workspace ") + root.item.name;
                clicked => {
                    Workspaces.open(root.item.id);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: "Delete";
                kind: "danger";
                accessible-label: "Delete workspace " + root.item.name;
                clicked => {
                    Workspaces.remove(root.item.id);
                }
            }
        }
    }
}

export component WorkspacesPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            width: root.width;
            alignment: start;
            padding: Theme.space-4;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;

                PageTitle {
                    horizontal-stretch: 1;
                    title: "Workspaces";
                    body: "A workspace keeps up to four panels side by side: terminals, files, a phone screen, logcat or a remote desktop. Opening one starts its sessions.";
                }

                VerticalLayout {
                    alignment: start;
                    Button {
                        text: "New workspace";
                        kind: "primary";
                        clicked => {
                            Workspaces.create();
                        }
                    }
                }
            }

            if Workspaces.error != "": Notice {
                kind: "danger";
                text: Workspaces.error;
            }

            if Workspaces.saved.length == 0 && Workspaces.error == "": Text {
                text: "No saved workspaces yet. Create one, add panels and save it.";
                color: Theme.text-muted;
                font-size: Theme.text-small;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: Theme.space-2;
                for item in Workspaces.saved: WorkspaceRow {
                    item: item;
                }
            }
        }
    }
}
