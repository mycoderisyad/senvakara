// The table of finished and running runs shown under the deploy form and under the recipes.

import { Theme } from "../../theme.slint";
import { StatusMark } from "../../components/widgets.slint";
import { RunRow } from "model.slint";

component Cell inherits Text {
    vertical-alignment: center;
    color: Theme.text-muted;
    font-size: Theme.text-small;
    overflow: elide;
}

export component HistoryTable inherits VerticalLayout {
    in property <[RunRow]> rows;
    // The heading of the middle column ("Mode", "Recipe"), or "" to leave it out.
    in property <string> what-title;
    private property <length> when-width: 124px;
    private property <length> what-width: 104px;
    private property <length> state-width: 96px;
    private property <length> time-width: 56px;

    HorizontalLayout {
        height: 26px;
        spacing: Theme.space-3;

        Cell {
            width: root.when-width;
            text: "When";
            font-weight: 600;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: "Target";
            font-weight: 600;
        }

        if root.what-title != "": Cell {
            width: root.what-width;
            text: root.what-title;
            font-weight: 600;
        }

        Cell {
            width: root.state-width;
            text: "Result";
            font-weight: 600;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: "Detail";
            font-weight: 600;
        }

        Cell {
            width: root.time-width;
            horizontal-alignment: right;
            text: "Duration";
            font-weight: 600;
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }

    for row in root.rows: HorizontalLayout {
        height: 28px;
        spacing: Theme.space-3;

        Cell {
            width: root.when-width;
            text: row.when;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: row.target;
            color: Theme.text;
        }

        if root.what-title != "": Cell {
            width: root.what-width;
            text: row.what;
        }

        StatusMark {
            width: root.state-width;
            alignment: start;
            tone: row.tone;
            text: row.state-text;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: row.result;
        }

        Cell {
            width: root.time-width;
            horizontal-alignment: right;
            text: row.duration;
        }
    }
}
