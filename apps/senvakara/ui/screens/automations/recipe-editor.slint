// The editor of the open recipe: name, target phone, permissions, the steps and Save, Run, Delete.

import { Theme } from "../../theme.slint";
import { IconButton } from "../../components/controls.slint";
import { Button, GroupTitle, Notice, TextField, BoundField, CheckBox, Segmented, Select, Hint, Labeled } from "../../components/widgets.slint";
import { Recipes, StepItem } from "model.slint";

component StepEditor inherits VerticalLayout {
    in property <StepItem> step;
    in property <int> index;
    private property <string> name: "step " + (index + 1);

    spacing: Theme.space-1;

    HorizontalLayout {
        height: Theme.row;
        spacing: Theme.space-2;

        Text {
            width: 20px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: (root.index + 1) + ".";
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        Select {
            width: 200px;
            horizontal-stretch: 0;
            model: Recipes.kinds;
            index: root.step.kind-index;
            label: "Kind of " + root.name;
            picked(kind) => {
                Recipes.step-kind(root.index, kind);
            }
        }

        if root.step.kind != "wait": BoundField {
            horizontal-stretch: 1;
            mono: true;
            value: root.step.text;
            label: root.step.kind == "install_apk" ? "APK file of " + root.name : root.step.kind == "device_shell" ? "Command of " + root.name : root.step.kind == "screenshot" ? "Folder of " + root.name : root.step.kind == "flutter_deploy" ? "Project folder of " + root.name : "Package of " + root.name;
            placeholder: root.step.kind == "install_apk" ? "Path to the .apk file" : root.step.kind == "device_shell" ? "getprop ro.build.version.release" : root.step.kind == "screenshot" ? "Folder to save the picture in" : root.step.kind == "flutter_deploy" ? "The folder that holds pubspec.yaml" : "com.example.app";
            edited(text) => {
                Recipes.step-text(root.index, text);
            }
        }

        if root.step.kind == "install_apk" || root.step.kind == "screenshot" || root.step.kind == "flutter_deploy": Button {
            text: "Browse";
            accessible-label: "Browse for " + root.name;
            clicked => {
                Recipes.step-browse(root.index);
            }
        }

        if root.step.kind == "wait": BoundField {
            width: 72px;
            value: root.step.seconds;
            label: "Seconds to wait in " + root.name;
            placeholder: "1 to 300";
            edited(text) => {
                Recipes.step-seconds(root.index, text);
            }
        }

        if root.step.kind == "wait": Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: "seconds (1 to 300)";
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../../icons/up.svg");
                label: root.step.first ? "Move " + root.name + " up. Unavailable: it is the first step." : "Move " + root.name + " up";
                enabled: !root.step.first;
                clicked => {
                    Recipes.step-move(root.index, -1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../../icons/down.svg");
                label: root.step.last ? "Move " + root.name + " down. Unavailable: it is the last step." : "Move " + root.name + " down";
                enabled: !root.step.last;
                clicked => {
                    Recipes.step-move(root.index, 1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../../icons/trash.svg");
                label: Recipes.remove-reason == "" ? "Remove " + root.name : "Remove " + root.name + ". Unavailable: " + Recipes.remove-reason;
                enabled: Recipes.remove-reason == "";
                clicked => {
                    Recipes.step-remove(root.index);
                }
            }
        }
    }

    if root.step.kind == "flutter_deploy": HorizontalLayout {
        height: Theme.row;
        padding-left: 20px + Theme.space-2;
        spacing: Theme.space-3;
        alignment: start;

        Segmented {
            width: 190px;
            items: [{ id: "release", label: "Release" }, { id: "debug", label: "Debug" }];
            current: root.step.mode;
            picked(id) => {
                Recipes.step-mode(root.index, id);
            }
        }

        CheckBox {
            text: "Launch after install";
            checked: root.step.launch;
            toggled(on) => {
                Recipes.step-launch(root.index, on);
            }
        }
    }

    if root.step.error != "": HorizontalLayout {
        padding-left: 20px + Theme.space-2;
        Hint {
            text: root.step.error;
            ink: Theme.danger;
        }
    }
}

export component RecipeEditor inherits VerticalLayout {
    spacing: Theme.space-3;
    alignment: start;

    HorizontalLayout {
        spacing: Theme.space-2;

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Recipes.title;
            color: Theme.text;
            font-size: Theme.text-body;
            font-weight: Theme.weight-strong;
            overflow: elide;
        }

        IconButton {
            icon: @image-url("../../icons/close.svg");
            label: "Close the recipe";
            clicked => {
                Recipes.close();
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-4;

        Labeled {
            horizontal-stretch: 1;
            label: "Name";
            error: Recipes.name-error;
            TextField {
                text <=> Recipes.name;
                label: "Recipe name";
                placeholder: "Up to 80 characters";
                edited => {
                    Recipes.edited();
                }
            }
        }

        Labeled {
            horizontal-stretch: 1;
            label: "Target phone";
            Select {
                model: Recipes.targets;
                index: Recipes.target-index;
                label: "Target phone of the recipe";
                picked(index) => {
                    Recipes.pick-target(index);
                }
            }
        }
    }

    GroupTitle {
        text: "This recipe may";
    }

    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-4;

        CheckBox {
            text: "Install or uninstall apps";
            checked: Recipes.allow-install;
            toggled(on) => {
                Recipes.set-install(on);
            }
        }

        CheckBox {
            text: "Run shell commands on the phone";
            checked: Recipes.allow-shell;
            toggled(on) => {
                Recipes.set-shell(on);
            }
        }
    }

    GroupTitle {
        text: "Steps";
    }

    for step[index] in Recipes.steps: StepEditor {
        step: step;
        index: index;
    }

    HorizontalLayout {
        spacing: Theme.space-3;

        Button {
            text: "Add step";
            enabled: Recipes.add-reason == "";
            reason: Recipes.add-reason;
            clicked => {
                Recipes.step-add();
            }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Recipes.add-reason != "" ? Recipes.add-reason : Recipes.remove-reason;
            color: Theme.text-faint;
            font-size: Theme.text-small;
            overflow: elide;
        }
    }

    if Recipes.permission-warning != "": Notice {
        text: Recipes.permission-warning;
    }

    if Recipes.target-warning != "": Notice {
        kind: "info";
        text: Recipes.target-warning;
    }

    if Recipes.error != "": Notice {
        kind: "danger";
        text: Recipes.error;
    }

    HorizontalLayout {
        spacing: Theme.space-2;

        if Recipes.saved: Button {
            text: "Delete";
            kind: "danger";
            accessible-label: "Delete this recipe";
            clicked => {
                Recipes.remove();
            }
        }

        // One reason at a time: what stops Run matters more than what stops Save.
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: Recipes.run-reason != "" ? Recipes.run-reason : Recipes.save-reason;
            color: Theme.text-faint;
            font-size: Theme.text-small;
            overflow: elide;
        }

        Button {
            text: "Save";
            enabled: Recipes.save-reason == "";
            reason: Recipes.save-reason;
            accessible-label: Recipes.save-reason == "" ? "Save this recipe" : "Save this recipe. Unavailable: " + Recipes.save-reason;
            clicked => {
                Recipes.save();
            }
        }

        Button {
            text: "Run";
            kind: "primary";
            enabled: Recipes.run-reason == "";
            reason: Recipes.run-reason;
            accessible-label: Recipes.run-reason == "" ? "Run this recipe" : "Run this recipe. Unavailable: " + Recipes.run-reason;
            clicked => {
                Recipes.run();
            }
        }
    }

}
