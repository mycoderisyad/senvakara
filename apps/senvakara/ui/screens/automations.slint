// The Automations section of Home: Flutter build-and-deploy and saved recipes. Rust validates,
// words every reason and starts the runs; a run opens as a session tab.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PageToolbar, SectionHeader, ToolButton } from "../components/widgets.slint";
import { DeployCard } from "automations/deploy-card.slint";
import { RecipesCard } from "automations/recipes-card.slint";

import { Recipes } from "automations/model.slint";
export { RunRow, Deploy, RecipeItem, StepItem, Recipes } from "automations/model.slint";

export component AutomationsPage inherits VerticalLayout {
    PageToolbar {
        ToolButton {
            icon: @image-url("../icons/plus.svg");
            text: "New recipe";
            filled: true;
            clicked => {
                Recipes.create();
            }
        }
    }

    ScrollView {
        VerticalLayout {
            // Forms read badly when a field runs across a wide screen.
            width: Math.min(root.width, 960px);
            alignment: start;
            padding-left: Theme.space-6;
            padding-right: Theme.space-6;
            padding-top: Theme.space-5;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-5;

            SectionHeader {
                title: "Automations";
                detail: "Every run opens in its own tab";
            }

            DeployCard { }

            RecipesCard { }
        }
    }
}
