// The Automations section of Home: Flutter build-and-deploy and saved recipes. Rust validates,
// words every reason and starts the runs; a run opens as a session tab.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconButton } from "../components/controls.slint";
import { Button, GroupTitle, Notice, TextField, BoundField, CheckBox, Segmented, Select, StatusMark, Hint, Labeled, PageTitle, Card } from "../components/widgets.slint";

// One finished or running run in a history table.
export struct RunRow {
    // "2026-11-22 14:05"
    when: string,
    target: string,
    // The build mode or the recipe name, depending on the table.
    what: string,
    tone: string,
    // "Succeeded" | "Failed" | "Cancelled" | "Running"
    state-text: string,
    result: string,
    // "42 s"
    duration: string,
}

export global Deploy {
    // "live" | "attention" | "busy"
    in property <string> sdk-tone: "busy";
    // "Flutter 3.24.0" | "Flutter SDK not found" | "Looking for the Flutter SDK"
    in property <string> sdk-text;
    // Where the SDK is, or what to do when it is missing.
    in property <string> sdk-detail;
    in property <string> build-host;
    in-out property <string> project;
    // "release" | "debug"
    in property <string> mode: "release";
    in property <[string]> targets;
    in property <int> target-index;
    in property <bool> launch: true;
    in property <bool> logcat: true;
    // Why "Build and deploy" cannot be pressed ("" when it can).
    in property <string> reason;
    in property <string> error;
    in property <[RunRow]> history;

    callback edited();
    callback browse();
    callback set-mode(mode: string);
    callback pick-target(index: int);
    callback set-launch(on: bool);
    callback set-logcat(on: bool);
    callback start();
}

export struct RecipeItem {
    id: string,
    name: string,
    // "3 steps, for 2201117PG"
    detail: string,
    selected: bool,
}

export struct StepItem {
    // Index into Recipes.kinds, and the kind itself.
    kind-index: int,
    // install_apk | uninstall_package | launch_app | wait | device_shell | screenshot | flutter_deploy
    kind: string,
    // The path, package, command, folder or project of the step.
    text: string,
    seconds: string,
    // "release" | "debug"
    mode: string,
    launch: bool,
    // What is wrong with the step, in words.
    error: string,
    first: bool,
    last: bool,
}

export global Recipes {
    in property <[RecipeItem]> items;
    // A recipe is open in the editor.
    in property <bool> editing;
    // "New recipe" | "Edit Smoke test"
    in property <string> title;
    // The open recipe has been saved at least once.
    in property <bool> saved;
    in-out property <string> name;
    in property <string> name-error;
    in property <[string]> targets;
    in property <int> target-index;
    in property <bool> allow-install;
    in property <bool> allow-shell;
    in property <[StepItem]> steps;
    in property <[string]> kinds;
    // Why each button cannot be pressed ("" when it can).
    in property <string> add-reason;
    in property <string> remove-reason;
    in property <string> save-reason;
    in property <string> run-reason;
    in property <string> permission-warning;
    in property <string> target-warning;
    in property <string> error;
    // Runs of the open recipe, or of every recipe when none is open.
    in property <[RunRow]> history;

    callback select(id: string);
    callback create();
    callback close();
    callback edited();
    callback pick-target(index: int);
    callback set-install(on: bool);
    callback set-shell(on: bool);
    callback step-kind(step: int, kind: int);
    callback step-text(step: int, text: string);
    callback step-seconds(step: int, text: string);
    callback step-mode(step: int, mode: string);
    callback step-launch(step: int, on: bool);
    callback step-browse(step: int);
    callback step-move(step: int, by: int);
    callback step-remove(step: int);
    callback step-add();
    callback save();
    callback remove();
    callback run();
}

component Cell inherits Text {
    vertical-alignment: center;
    color: Theme.text-muted;
    font-size: Theme.text-small;
    overflow: elide;
}

export component HistoryTable inherits VerticalLayout {
    in property <[RunRow]> rows;
    // The heading of the middle column ("Mode", "Recipe"), or "" to leave it out.
    in property <string> what-title;
    private property <length> when-width: 124px;
    private property <length> what-width: 104px;
    private property <length> state-width: 96px;
    private property <length> time-width: 56px;

    HorizontalLayout {
        height: 26px;
        spacing: Theme.space-3;

        Cell {
            width: root.when-width;
            text: "When";
            font-weight: 600;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: "Target";
            font-weight: 600;
        }

        if root.what-title != "": Cell {
            width: root.what-width;
            text: root.what-title;
            font-weight: 600;
        }

        Cell {
            width: root.state-width;
            text: "Result";
            font-weight: 600;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: "Detail";
            font-weight: 600;
        }

        Cell {
            width: root.time-width;
            horizontal-alignment: right;
            text: "Duration";
            font-weight: 600;
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }

    for row in root.rows: HorizontalLayout {
        height: 28px;
        spacing: Theme.space-3;

        Cell {
            width: root.when-width;
            text: row.when;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: row.target;
            color: Theme.text;
        }

        if root.what-title != "": Cell {
            width: root.what-width;
            text: row.what;
        }

        StatusMark {
            width: root.state-width;
            alignment: start;
            tone: row.tone;
            text: row.state-text;
        }

        Cell {
            horizontal-stretch: 3;
            min-width: 0px;
            preferred-width: 0px;
            text: row.result;
        }

        Cell {
            width: root.time-width;
            horizontal-alignment: right;
            text: row.duration;
        }
    }
}

component DeployCard inherits Card {
    GroupTitle {
        text: "Flutter build and deploy";
    }

    Hint {
        text: "Builds the app on " + Deploy.build-host + " and installs it on a phone, also one that is plugged into another host.";
    }

    HorizontalLayout {
        spacing: Theme.space-3;

        StatusMark {
            horizontal-stretch: 0;
            alignment: start;
            tone: Deploy.sdk-tone;
            text: Deploy.sdk-text;
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Deploy.sdk-detail;
            color: Theme.text-faint;
            font-size: Theme.text-small;
            font-family: Deploy.sdk-tone == "live" ? Theme.mono : Theme.sans;
            overflow: elide;
        }
    }

    Labeled {
        label: "Project folder";
        HorizontalLayout {
            spacing: Theme.space-2;

            TextField {
                horizontal-stretch: 1;
                mono: true;
                text <=> Deploy.project;
                label: "Flutter project folder";
                placeholder: "The folder that holds pubspec.yaml";
                edited => {
                    Deploy.edited();
                }
            }

            Button {
                text: "Browse";
                accessible-label: "Browse for the Flutter project folder";
                clicked => {
                    Deploy.browse();
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-4;

        Labeled {
            label: "Mode";
            Segmented {
                width: 190px;
                items: [{ id: "release", label: "Release" }, { id: "debug", label: "Debug" }];
                current: Deploy.mode;
                picked(id) => {
                    Deploy.set-mode(id);
                }
            }
        }

        Labeled {
            horizontal-stretch: 1;
            label: "Target phone";
            Select {
                model: Deploy.targets;
                index: Deploy.target-index;
                label: "Target phone for the build";
                enabled: Deploy.targets.length > 0;
                picked(index) => {
                    Deploy.pick-target(index);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-3;

        CheckBox {
            text: "Launch after install";
            checked: Deploy.launch;
            toggled(on) => {
                Deploy.set-launch(on);
            }
        }

        CheckBox {
            text: "Show app log";
            checked: Deploy.logcat && Deploy.launch;
            enabled: Deploy.launch;
            reason: "The app log is only read when the app is launched.";
            toggled(on) => {
                Deploy.set-logcat(on);
            }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: Deploy.reason != "" ? Deploy.reason : !Deploy.launch ? "The app log is only read when the app is launched." : "";
            color: Theme.text-faint;
            font-size: Theme.text-small;
            overflow: elide;
        }

        Button {
            text: "Build and deploy";
            kind: "primary";
            enabled: Deploy.reason == "";
            reason: Deploy.reason;
            clicked => {
                Deploy.start();
            }
        }
    }

    if Deploy.error != "": Notice {
        kind: "danger";
        text: Deploy.error;
    }

    if Deploy.history.length > 0: GroupTitle {
        text: "Deploy runs";
    }

    if Deploy.history.length > 0: HistoryTable {
        rows: Deploy.history;
        what-title: "Mode";
    }
}

component RecipeRow inherits Rectangle {
    in property <RecipeItem> item;

    height: 44px;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: item.selected ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: "Recipe " + item.name + ", " + item.detail;
    accessible-item-selected: item.selected;
    accessible-action-default => {
        Recipes.select(item.id);
    }
    animate background { duration: Theme.quick; }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Recipes.select(root.item.id);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            Recipes.select(root.item.id);
        }
    }

    VerticalLayout {
        alignment: center;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: 2px;

        Text {
            text: root.item.name;
            color: Theme.text;
            font-size: Theme.text-body;
            font-weight: root.item.selected ? 600 : 400;
            overflow: elide;
        }

        Text {
            text: root.item.detail;
            color: Theme.text-muted;
            font-size: Theme.text-small;
            overflow: elide;
        }
    }
}

component StepEditor inherits VerticalLayout {
    in property <StepItem> step;
    in property <int> index;
    private property <string> name: "step " + (index + 1);

    spacing: Theme.space-1;

    HorizontalLayout {
        height: Theme.row;
        spacing: Theme.space-2;

        Text {
            width: 20px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: (root.index + 1) + ".";
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        Select {
            width: 200px;
            horizontal-stretch: 0;
            model: Recipes.kinds;
            index: root.step.kind-index;
            label: "Kind of " + root.name;
            picked(kind) => {
                Recipes.step-kind(root.index, kind);
            }
        }

        if root.step.kind != "wait": BoundField {
            horizontal-stretch: 1;
            mono: true;
            value: root.step.text;
            label: root.step.kind == "install_apk" ? "APK file of " + root.name : root.step.kind == "device_shell" ? "Command of " + root.name : root.step.kind == "screenshot" ? "Folder of " + root.name : root.step.kind == "flutter_deploy" ? "Project folder of " + root.name : "Package of " + root.name;
            placeholder: root.step.kind == "install_apk" ? "Path to the .apk file" : root.step.kind == "device_shell" ? "getprop ro.build.version.release" : root.step.kind == "screenshot" ? "Folder to save the picture in" : root.step.kind == "flutter_deploy" ? "The folder that holds pubspec.yaml" : "com.example.app";
            edited(text) => {
                Recipes.step-text(root.index, text);
            }
        }

        if root.step.kind == "install_apk" || root.step.kind == "screenshot" || root.step.kind == "flutter_deploy": Button {
            text: "Browse";
            accessible-label: "Browse for " + root.name;
            clicked => {
                Recipes.step-browse(root.index);
            }
        }

        if root.step.kind == "wait": BoundField {
            width: 72px;
            value: root.step.seconds;
            label: "Seconds to wait in " + root.name;
            placeholder: "1 to 300";
            edited(text) => {
                Recipes.step-seconds(root.index, text);
            }
        }

        if root.step.kind == "wait": Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: "seconds (1 to 300)";
            color: Theme.text-muted;
            font-size: Theme.text-small;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/up.svg");
                label: root.step.first ? "Move " + root.name + " up. Unavailable: it is the first step." : "Move " + root.name + " up";
                enabled: !root.step.first;
                clicked => {
                    Recipes.step-move(root.index, -1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/down.svg");
                label: root.step.last ? "Move " + root.name + " down. Unavailable: it is the last step." : "Move " + root.name + " down";
                enabled: !root.step.last;
                clicked => {
                    Recipes.step-move(root.index, 1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/trash.svg");
                label: Recipes.remove-reason == "" ? "Remove " + root.name : "Remove " + root.name + ". Unavailable: " + Recipes.remove-reason;
                enabled: Recipes.remove-reason == "";
                clicked => {
                    Recipes.step-remove(root.index);
                }
            }
        }
    }

    if root.step.kind == "flutter_deploy": HorizontalLayout {
        height: Theme.row;
        padding-left: 20px + Theme.space-2;
        spacing: Theme.space-3;
        alignment: start;

        Segmented {
            width: 190px;
            items: [{ id: "release", label: "Release" }, { id: "debug", label: "Debug" }];
            current: root.step.mode;
            picked(id) => {
                Recipes.step-mode(root.index, id);
            }
        }

        CheckBox {
            text: "Launch after install";
            checked: root.step.launch;
            toggled(on) => {
                Recipes.step-launch(root.index, on);
            }
        }
    }

    if root.step.error != "": HorizontalLayout {
        padding-left: 20px + Theme.space-2;
        Hint {
            text: root.step.error;
            ink: Theme.danger;
        }
    }
}

component RecipeEditor inherits VerticalLayout {
    spacing: Theme.space-3;
    alignment: start;

    HorizontalLayout {
        spacing: Theme.space-2;

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Recipes.title;
            color: Theme.text;
            font-size: Theme.text-body;
            font-weight: 600;
            overflow: elide;
        }

        IconButton {
            icon: @image-url("../icons/close.svg");
            label: "Close the recipe";
            clicked => {
                Recipes.close();
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-4;

        Labeled {
            horizontal-stretch: 1;
            label: "Name";
            error: Recipes.name-error;
            TextField {
                text <=> Recipes.name;
                label: "Recipe name";
                placeholder: "Up to 80 characters";
                edited => {
                    Recipes.edited();
                }
            }
        }

        Labeled {
            horizontal-stretch: 1;
            label: "Target phone";
            Select {
                model: Recipes.targets;
                index: Recipes.target-index;
                label: "Target phone of the recipe";
                picked(index) => {
                    Recipes.pick-target(index);
                }
            }
        }
    }

    GroupTitle {
        text: "This recipe may";
    }

    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-4;

        CheckBox {
            text: "Install or uninstall apps";
            checked: Recipes.allow-install;
            toggled(on) => {
                Recipes.set-install(on);
            }
        }

        CheckBox {
            text: "Run shell commands on the phone";
            checked: Recipes.allow-shell;
            toggled(on) => {
                Recipes.set-shell(on);
            }
        }
    }

    GroupTitle {
        text: "Steps";
    }

    for step[index] in Recipes.steps: StepEditor {
        step: step;
        index: index;
    }

    HorizontalLayout {
        spacing: Theme.space-3;

        Button {
            text: "Add step";
            enabled: Recipes.add-reason == "";
            reason: Recipes.add-reason;
            clicked => {
                Recipes.step-add();
            }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Recipes.add-reason != "" ? Recipes.add-reason : Recipes.remove-reason;
            color: Theme.text-faint;
            font-size: Theme.text-small;
            overflow: elide;
        }
    }

    if Recipes.permission-warning != "": Notice {
        text: Recipes.permission-warning;
    }

    if Recipes.target-warning != "": Notice {
        kind: "info";
        text: Recipes.target-warning;
    }

    if Recipes.error != "": Notice {
        kind: "danger";
        text: Recipes.error;
    }

    HorizontalLayout {
        spacing: Theme.space-2;

        if Recipes.saved: Button {
            text: "Delete";
            kind: "danger";
            accessible-label: "Delete this recipe";
            clicked => {
                Recipes.remove();
            }
        }

        // One reason at a time: what stops Run matters more than what stops Save.
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: Recipes.run-reason != "" ? Recipes.run-reason : Recipes.save-reason;
            color: Theme.text-faint;
            font-size: Theme.text-small;
            overflow: elide;
        }

        Button {
            text: "Save";
            enabled: Recipes.save-reason == "";
            reason: Recipes.save-reason;
            accessible-label: Recipes.save-reason == "" ? "Save this recipe" : "Save this recipe. Unavailable: " + Recipes.save-reason;
            clicked => {
                Recipes.save();
            }
        }

        Button {
            text: "Run";
            kind: "primary";
            enabled: Recipes.run-reason == "";
            reason: Recipes.run-reason;
            accessible-label: Recipes.run-reason == "" ? "Run this recipe" : "Run this recipe. Unavailable: " + Recipes.run-reason;
            clicked => {
                Recipes.run();
            }
        }
    }

}

component RecipesCard inherits Card {
    GroupTitle {
        text: "Recipes";
    }

    Hint {
        text: "A recipe is a list of steps for one phone. It runs after one confirmation and stops at the first step that fails.";
    }

    HorizontalLayout {
        spacing: Theme.space-4;

        VerticalLayout {
            width: 232px;
            alignment: start;
            spacing: Theme.space-1;

            HorizontalLayout {
                alignment: start;
                Button {
                    text: "New recipe";
                    clicked => {
                        Recipes.create();
                    }
                }
            }

            Rectangle {
                height: Theme.space-1;
            }

            if Recipes.items.length == 0: Text {
                text: "No recipes yet.";
                color: Theme.text-muted;
                font-size: Theme.text-small;
            }

            for item in Recipes.items: RecipeRow {
                item: item;
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.hairline;
        }

        if Recipes.editing: RecipeEditor {
            horizontal-stretch: 1;
        }

        if !Recipes.editing: VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: Theme.space-3;

            Text {
                text: "Choose a recipe to edit or run it, or create a new one.";
                color: Theme.text-muted;
                font-size: Theme.text-small;
                wrap: word-wrap;
            }
        }
    }

    // The runs of the open recipe, or of every recipe when none is open. Under the editor, at
    // the full width of the card, so the columns keep their room in a small window.
    if Recipes.history.length > 0: GroupTitle {
        text: Recipes.editing ? "Runs of this recipe" : "All recipe runs";
    }

    if Recipes.history.length > 0: HistoryTable {
        rows: Recipes.history;
        what-title: Recipes.editing ? "" : "Recipe";
    }
}

export component AutomationsPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            width: root.width;
            alignment: start;
            padding: Theme.space-4;
            spacing: Theme.space-4;

            PageTitle {
                title: "Automations";
                body: "Build and install a Flutter app, or save a list of steps for one phone and run it again. Every run opens in its own tab and can be cancelled there.";
            }

            DeployCard { }

            RecipesCard { }
        }
    }
}
