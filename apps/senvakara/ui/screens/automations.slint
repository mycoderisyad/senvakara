// The Automations section of Home: Flutter build-and-deploy and saved recipes. Rust validates,
// words every reason and starts the runs; a run opens as a session tab.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PageTitle } from "../components/widgets.slint";
import { DeployCard } from "automations/deploy-card.slint";
import { RecipesCard } from "automations/recipes-card.slint";

export { RunRow, Deploy, RecipeItem, StepItem, Recipes } from "automations/model.slint";

export component AutomationsPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            width: root.width;
            alignment: start;
            padding-left: Theme.space-6;
            padding-right: Theme.space-6;
            padding-top: Theme.space-5;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-5;

            PageTitle {
                title: "Automations";
                body: "Build and install a Flutter app, or save a list of steps for one phone and run it again. Every run opens in its own tab and can be cancelled there.";
            }

            DeployCard { }

            RecipesCard { }
        }
    }
}
