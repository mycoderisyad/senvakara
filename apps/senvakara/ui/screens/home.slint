// Home: the inventory. Sidebar on the left, hosts and devices in the middle, inspector on the right.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconButton } from "../components/controls.slint";
import { Button, SearchField, SidebarItem, ItemCard, GroupTitle, Notice, StatusMark, MeterRow, DetailRow, ActionList, CardGrid, Card, SectionHeader, EmptyState, PageToolbar, ToolButton } from "../components/widgets.slint";
import { DevicePanel } from "../components/device-panel.slint";
import { HostFormPanel, NetworkPaths, HostForm } from "../components/host-form.slint";
import { JobList, Jobs } from "../components/jobs.slint";
import { Inventory, HostItem, DeviceItem, Action } from "../data.slint";
import { WorkspacesPage } from "workspaces.slint";
import { AutomationsPage } from "automations.slint";
import { SettingsPage } from "settings.slint";
import { KeychainPage, KeyInspector, Keychain } from "keychain.slint";

export global Nav {
    // "hosts" | "devices" | "keychain" | "workspaces" | "automations" | "settings"
    in-out property <string> section: "hosts";
    // The user went to a section: Rust refreshes what it shows.
    callback opened(section: string);
    // "" until the list has been read, then "0", "1", ...
    in property <string> workspace-count;
}

// The hosts, one grid per parent group.
component HostGrid inherits VerticalLayout {
    spacing: Theme.space-6;

    for group[group-index] in Inventory.host-groups: VerticalLayout {
        spacing: Theme.space-3;

        // The hosts without a group come first and sit under the page title itself.
        if group-index > 0 || (group.name != "" && group.name != "Hosts"): GroupTitle {
            text: group.name;
        }

        grid := CardGrid {
            count: group.hosts.length;
            for host[index] in group.hosts: ItemCard {
                x: grid.card-x(index);
                y: grid.card-y(index);
                width: grid.card-width;
                icon: host.os == "windows" ? @image-url("../icons/windows.svg") : host.os == "rdp" ? @image-url("../icons/monitor.svg") : @image-url("../icons/server.svg");
                hue: Theme.host-hue(host.hue);
                title: host.name;
                subtitle: host.subtitle;
                tone: host.tone;
                state-text: host.state-text;
                selected: Inventory.selected-kind == "host" && Inventory.selected-id == host.id;
                actions: host.actions;
                select => {
                    Inventory.select("host", host.id);
                }
                open => {
                    Inventory.host-action(host.id, host.primary.id);
                }
                action(id) => {
                    Inventory.host-action(host.id, id);
                }
            }
        }
    }
}

component DeviceGrid inherits VerticalLayout {
    spacing: Theme.space-3;

    GroupTitle {
        text: "Phones";
    }

    grid := CardGrid {
        count: Inventory.devices.length;
        for device[index] in Inventory.devices: ItemCard {
            x: grid.card-x(index);
            y: grid.card-y(index);
            width: grid.card-width;
            icon: @image-url("../icons/phone.svg");
            hue: Theme.host-hue(device.host-hue);
            title: device.name;
            subtitle: device.route;
            tone: device.tone;
            state-text: device.state-text;
            selected: Inventory.selected-kind == "device" && Inventory.selected-id == device.id;
            actions: device.actions;
            select => {
                Inventory.select("device", device.id);
            }
            open => {
                Inventory.device-action(device.id, device.primary.id);
            }
            action(id) => {
                Inventory.device-action(device.id, id);
            }
        }
    }
}

// A titled block of the inspector.
component InspectorCard inherits Card {
    in property <string> title;
    gap: Theme.space-3;

    GroupTitle {
        text: root.title;
    }

    @children
}

component Inspector inherits Rectangle {
    private property <bool> is-host: Inventory.selected-kind == "host";
    private property <HostItem> host: Inventory.selected-host;
    private property <DeviceItem> device: Inventory.selected-device;

    width: Theme.inspector-width;
    background: Theme.ground;

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.hairline;
    }

    ScrollView {
        VerticalLayout {
            // Keep the content as wide as the panel: long values wrap instead of widening it.
            width: root.width;
            alignment: start;
            padding: Theme.space-4;
            padding-top: Theme.space-5;
            spacing: Theme.space-4;

            // Adding or editing a host takes the whole panel until it is saved or cancelled.
            if HostForm.open: HostFormPanel { }

            if !HostForm.open: HorizontalLayout {
                spacing: Theme.space-3;

                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Theme.radius + 2px;
                        background: Theme.host-hue(root.is-host ? root.host.hue : root.device.host-hue);
                        Icon {
                            width: 20px;
                            height: 20px;
                            source: !root.is-host ? @image-url("../icons/phone.svg") : root.host.os == "windows" ? @image-url("../icons/windows.svg") : root.host.os == "rdp" ? @image-url("../icons/monitor.svg") : @image-url("../icons/server.svg");
                            tint: Theme.tile-ink;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.is-host ? root.host.name : root.device.name;
                        color: Theme.text;
                        font-size: Theme.text-body + 2px;
                        font-weight: Theme.weight-strong;
                        overflow: elide;
                    }

                    Text {
                        text: root.is-host ? root.host.subtitle : root.device.route;
                        color: Theme.text-muted;
                        font-size: Theme.text-small;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: start;
                    IconButton {
                        icon: @image-url("../icons/close.svg");
                        label: "Close details";
                        clicked => {
                            Inventory.select("", "");
                        }
                    }
                }
            }

            if !HostForm.open: HorizontalLayout {
                alignment: start;
                StatusMark {
                    alignment: start;
                    tone: root.is-host ? root.host.tone : root.device.tone;
                    text: root.is-host ? root.host.state-text : root.device.state-text;
                }
            }

            if !HostForm.open && root.is-host && root.host.error != "": Notice {
                kind: "danger";
                text: root.host.error;
            }

            if !HostForm.open && !root.is-host && root.device.hint != "": Notice {
                text: root.device.hint;
            }

            if !HostForm.open && !root.is-host: DevicePanel {
                device: root.device;
            }

            if !HostForm.open && root.is-host: ActionList {
                primary: root.host.primary;
                actions: root.host.actions;
                run(id) => {
                    Inventory.host-action(root.host.id, id);
                }
            }

            if !HostForm.open && root.is-host && root.host.meters.length > 0: InspectorCard {
                title: "Health";

                for meter in root.host.meters: MeterRow {
                    meter: meter;
                }

                if root.host.meters-note != "": Text {
                    text: root.host.meters-note;
                    color: Theme.text-muted;
                    font-size: Theme.text-small;
                    wrap: word-wrap;
                }
            }

            if !HostForm.open && root.is-host && root.host.details.length > 0: InspectorCard {
                title: "Details";
                gap: Theme.space-2;

                for item in root.host.details: DetailRow {
                    item: item;
                }
            }

            if !HostForm.open && root.is-host && root.host.paths.length > 0: NetworkPaths {
                host: root.host;
            }
        }
    }
}

component Sidebar inherits Rectangle {
    width: Theme.sidebar-width;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-2 + 2px;
        padding-top: Theme.space-4;
        spacing: Theme.space-1;

        // The product name, as the vault title is in Termius.
        HorizontalLayout {
            padding-left: Theme.space-2;
            padding-bottom: Theme.space-3;
            spacing: Theme.space-2;

            VerticalLayout {
                alignment: center;
                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/app.png");
                }
            }

            Text {
                vertical-alignment: center;
                text: "Senvakara";
                color: Theme.text;
                font-size: Theme.text-body + 1px;
                font-weight: Theme.weight-strong;
            }
        }

        SidebarItem {
            icon: @image-url("../icons/server.svg");
            text: "Hosts";
            badge: Inventory.hosts.length;
            active: Nav.section == "hosts";
            clicked => {
                Nav.section = "hosts";
                Nav.opened("hosts");
            }
        }

        SidebarItem {
            icon: @image-url("../icons/phone.svg");
            text: "Devices";
            badge: Inventory.devices.length;
            active: Nav.section == "devices";
            clicked => {
                Nav.section = "devices";
                Nav.opened("devices");
            }
        }

        SidebarItem {
            icon: @image-url("../icons/key.svg");
            text: "Keychain";
            badge: Keychain.keys.length;
            active: Nav.section == "keychain";
            clicked => {
                Nav.section = "keychain";
                Nav.opened("keychain");
            }
        }

        SidebarItem {
            icon: @image-url("../icons/layout.svg");
            text: "Workspaces";
            badge: Nav.workspace-count;
            active: Nav.section == "workspaces";
            clicked => {
                Nav.section = "workspaces";
                Nav.opened("workspaces");
            }
        }

        SidebarItem {
            icon: @image-url("../icons/workflow.svg");
            text: "Automations";
            active: Nav.section == "automations";
            clicked => {
                Nav.section = "automations";
                Nav.opened("automations");
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        SidebarItem {
            icon: @image-url("../icons/settings.svg");
            text: "Settings";
            active: Nav.section == "settings";
            clicked => {
                Nav.section = "settings";
                Nav.opened("settings");
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.hairline;
    }
}

// Hosts or Devices: the search bar, the list and the jobs under it.
component InventoryPage inherits VerticalLayout {
    private property <bool> hosts: Nav.section == "hosts";

    PageToolbar {
        searchable: true;
        query <=> Inventory.query;
        placeholder: root.hosts ? "Find a host or ssh user@hostname..." : "Search phones by name, host or serial";
        search-action: root.hosts ? "Connect" : "";
        search-action-enabled: root.hosts && Inventory.can-connect;
        searched(text) => {
            Inventory.search(text);
        }
        refresh-label: "Refresh hosts, phones and local shells";
        search-accepted => {
            if (root.hosts && Inventory.can-connect) {
                Inventory.quick-connect();
            }
        }
        refreshed => {
            Inventory.refresh();
        }

        if root.hosts: ToolButton {
            icon: @image-url("../icons/plus.svg");
            text: "New host";
            filled: true;
            clicked => {
                Inventory.add-host();
            }
        }

        if !root.hosts: ToolButton {
            icon: @image-url("../icons/plus.svg");
            text: "Add over Wi-Fi";
            filled: true;
            clicked => {
                Inventory.add-wireless();
            }
        }
    }

    ScrollView {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.space-6;
            padding-right: Theme.space-6;
            padding-top: Theme.space-5;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-5;

            SectionHeader {
                title: root.hosts ? "Hosts" : "Devices";
                detail: Inventory.summary;
            }

            if Inventory.error != "": Notice {
                kind: "danger";
                text: Inventory.error;
            }

            if root.hosts && Inventory.host-groups.length > 0: HostGrid { }

            if root.hosts && Inventory.host-groups.length == 0: EmptyState {
                icon: Inventory.can-connect ? @image-url("../icons/terminal.svg") : @image-url("../icons/server.svg");
                title: Inventory.can-connect ? "Connect to " + Inventory.connect-target : Inventory.query != "" ? "No host matches \"\{Inventory.query}\"" : "No hosts yet";
                body: Inventory.can-connect ? "No saved host matches this address. Press Enter or Connect to start a quick SSH connection." : Inventory.query != "" ? "Search looks through names, addresses, user names, groups and tags." : "Add a computer you reach over SSH or Remote Desktop with New host. Its terminal, files, desktop and phones are then one click away.";
            }

            if !root.hosts && Inventory.adb-sources.length > 0: InspectorCard {
                title: "ADB on each host";
                gap: Theme.space-2;

                for source in Inventory.adb-sources: DetailRow {
                    item: source;
                }
            }

            if !root.hosts && Inventory.devices.length > 0: DeviceGrid { }

            if !root.hosts && Inventory.devices.length == 0 && !Inventory.loading: EmptyState {
                icon: @image-url("../icons/phone.svg");
                title: Inventory.query != "" ? "No phone matches \"\{Inventory.query}\"" : "No Android phones yet";
                body: Inventory.query != "" ? "Search looks through phone names, hosts and serials." : "Plug a phone into this PC or a connected host with USB debugging on, or pair one with Add over Wi-Fi.";
            }
        }
    }

    // Transfers and installs stay in view whatever is selected.
    if Jobs.items.length > 0: JobList { }
}

export component HomeScreen inherits Rectangle {
    background: Theme.ground;

    HorizontalLayout {
        Sidebar { }

        // Work area.
        VerticalLayout {
            horizontal-stretch: 1;

            if Nav.section == "hosts" || Nav.section == "devices": InventoryPage { }

            if Nav.section == "keychain": KeychainPage { }

            if Nav.section == "workspaces": WorkspacesPage { }

            if Nav.section == "automations": AutomationsPage { }

            if Nav.section == "settings": SettingsPage { }
        }

        if (Inventory.selected-kind != "" || HostForm.open) && (Nav.section == "hosts" || Nav.section == "devices"): Inspector { }

        if Nav.section == "keychain" && Keychain.form-open: KeyInspector { }
    }
}
