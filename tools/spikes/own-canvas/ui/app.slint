// Fallback canvas spike: every coordinate arrives in screen space from Rust,
// so zoom works without transforms (the software renderer has none).
import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct CNode {
    id: int,
    title: string,
    category: string,
    status: string,
    x: length,
    y: length,
    w: length,
    h: length,
    selected: bool,
}

// One Path per edge, sized to the edge's own bounding box so partial
// rendering can skip edges outside the dirty region.
export struct CEdge {
    x: length,
    y: length,
    w: length,
    h: length,
    commands: string,
}

component NodeCard inherits Rectangle {
    in property <CNode> node;
    in property <float> zoom;
    callback pressed(int);
    callback dragged(int, length, length);
    callback released(int);

    x: node.x;
    y: node.y;
    width: node.w;
    height: node.h;
    background: #1c1f24;
    border-color: node.selected ? #6ea8fe : #2e333b;
    border-width: 1px;
    border-radius: 10px * zoom;

    Rectangle {
        x: 10px * zoom;
        y: 10px * zoom;
        width: 24px * zoom;
        height: 24px * zoom;
        border-radius: 6px * zoom;
        background: #3a6ea5;
    }
    Text {
        x: 42px * zoom;
        y: 8px * zoom;
        text: node.title;
        color: #e6e8eb;
        font-size: 14px * zoom;
        font-weight: 600;
    }
    if zoom >= 0.5: Text {
        x: 42px * zoom;
        y: 28px * zoom;
        text: node.category;
        color: #9aa1ab;
        font-size: 12px * zoom;
    }
    if zoom >= 0.5: Text {
        x: 10px * zoom;
        y: 50px * zoom;
        text: node.status;
        color: #7fd19b;
        font-size: 12px * zoom;
    }
    // Ports
    Rectangle { x: -5px * zoom; y: parent.height / 2 - 5px * zoom; width: 10px * zoom; height: self.width; border-radius: self.width / 2; background: #8b929c; }
    Rectangle { x: parent.width - 5px * zoom; y: parent.height / 2 - 5px * zoom; width: 10px * zoom; height: self.width; border-radius: self.width / 2; background: #8b929c; }

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.pressed(node.id);
            } else if e.kind == PointerEventKind.up {
                root.released(node.id);
            }
        }
        moved => {
            if self.pressed {
                root.dragged(node.id, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

export component App inherits Window {
    title: "Own canvas spike";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #121418;

    in property <[CNode]> nodes;
    in property <[CEdge]> edges;
    in property <string> grid;
    in property <float> zoom: 1.0;

    callback zoom-to(float);
    callback node-pressed(int);
    callback node-dragged(int, length, length);
    callback node-released(int);

    VerticalBox {
        spacing: 8px;
        HorizontalBox {
            height: 40px;
            spacing: 8px;
            Button { text: "Zoom 50%"; clicked => { root.zoom-to(0.5); } }
            Button { text: "Zoom 100%"; clicked => { root.zoom-to(1.0); } }
            Button { text: "Zoom 150%"; clicked => { root.zoom-to(1.5); } }
        }
        Rectangle {
            clip: true;
            background: #15181d;
            // Sparse grid, one Path, recomputed only on pan/zoom/resize.
            Path {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: max(self.width / 1px, 1);
                viewbox-height: max(self.height / 1px, 1);
                commands: root.grid;
                stroke: #1f242b;
                stroke-width: 1px;
            }
            for e in root.edges: Path {
                x: e.x;
                y: e.y;
                width: e.w;
                height: e.h;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: max(e.w / 1px, 1);
                viewbox-height: max(e.h / 1px, 1);
                commands: e.commands;
                stroke: #6ea8fe;
                stroke-width: 2px;
            }
            for n in root.nodes: NodeCard {
                node: n;
                zoom: root.zoom;
                pressed(id) => { root.node-pressed(id); }
                dragged(id, dx, dy) => { root.node-dragged(id, dx, dy); }
                released(id) => { root.node-released(id); }
            }
        }
    }
}
